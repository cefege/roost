new file mode 100644
index 0000000000..46f2613512
--- /dev/null
+++ b/packages/coding-agent/src/modes/controllers/hosted-live-audio.ts
@@ -0,0 +1,111 @@
+import { randomUUID } from "node:crypto";
+import { logger, toError } from "@oh-my-pi/pi-utils";
+import type { LivePhase } from "@oh-my-pi/pi-tui/apps/live-visualizer";
+import type { ExtensionLiveSession, ExtensionLiveStartOptions } from "../../extensibility/extensions/types";
+import type { InteractiveLiveAudio } from "../types";
+
+interface HostedLiveCallbacks {
+	start(options: ExtensionLiveStartOptions): Promise<ExtensionLiveSession>;
+	reportFailure(error: Error): boolean;
+	showError(message: string): void;
+}
+
+interface HostedPeer {
+	readonly id: string;
+	readonly abort: AbortController;
+	muted: boolean;
+	mutations: Promise<void>;
+}
+
+/** Owns only the caller-side audio adapter; the canonical controller owns the call. */
+export class HostedLiveAudio {
+	readonly #audio: InteractiveLiveAudio;
+	readonly #callbacks: HostedLiveCallbacks;
+	#peer: HostedPeer | undefined;
+
+	constructor(audio: InteractiveLiveAudio, callbacks: HostedLiveCallbacks) {
+		this.#audio = audio;
+		this.#callbacks = callbacks;
+	}
+
+	get active(): boolean {
+		return this.#peer !== undefined;
+	}
+
+	async start(): Promise<void> {
+		if (this.#peer) throw new Error("A browser live call is already active");
+		const peer: HostedPeer = {
+			id: randomUUID(),
+			abort: new AbortController(),
+			muted: false,
+			mutations: Promise.resolve(),
+		};
+		this.#peer = peer;
+		try {
+			// Preparing SDP must not request microphone access or open a speaker.
+			const sdpOffer = await this.#audio.prepare(peer.id, peer.abort.signal);
+			if (this.#peer !== peer) return;
+			const session = await this.#callbacks.start({
+				sdpOffer,
+				onPhase: phase => this.#setPhase(peer, phase),
+				onEnd: () => this.#release(peer),
+			});
+			if (this.#peer !== peer) {
+				await session.stop();
+				return;
+			}
+			// Only an authenticated canonical session may ask the browser for audio.
+			await this.#audio.connect(peer.id, session.sdpAnswer, peer.abort.signal);
+		} catch (cause) {
+			if (this.#peer !== peer) return;
+			const error = toError(cause);
+			if (!this.#callbacks.reportFailure(error)) this.#callbacks.showError(error.message);
+			this.#release(peer);
+		}
+	}
+
+	stop(): void {
+		if (this.#peer) this.#release(this.#peer);
+	}
+
+	reportMediaError(value: string): void {
+		const peer = this.#peer;
+		if (!peer || value.length > 2048) return;
+		let payload: unknown;
+		try {
+			payload = JSON.parse(value);
+		} catch {
+			return;
+		}
+		if (!payload || typeof payload !== "object") return;
+		const failure = payload as { peerId?: unknown; error?: unknown };
+		if (
+			Object.keys(failure).length !== 2 ||
+			failure.peerId !== peer.id ||
+			typeof failure.error !== "string" ||
+			!failure.error.trim()
+		) return;
+		this.#callbacks.reportFailure(new Error(failure.error.trim().slice(0, 512)));
+	}
+
+	#setPhase(peer: HostedPeer, phase: LivePhase): void {
+		if (this.#peer !== peer || phase === "error") return;
+		const muted = phase === "muted";
+		if (peer.muted === muted) return;
+		peer.muted = muted;
+		peer.mutations = peer.mutations.then(async () => {
+			if (this.#peer === peer) await this.#audio.mute(peer.id, muted);
+		}).catch(cause => {
+			if (this.#peer === peer) this.#callbacks.reportFailure(toError(cause));
+		});
+	}
+
+	#release(peer: HostedPeer): void {
+		if (this.#peer !== peer) return;
+		this.#peer = undefined;
+		peer.abort.abort(new Error("The live call has ended."));
+		void this.#audio.close(peer.id).catch(cause => {
+			logger.warn("Live browser audio cleanup failed", { error: toError(cause).message });
+		});
+	}
+}
