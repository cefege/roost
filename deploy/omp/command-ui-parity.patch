diff --git a/packages/coding-agent/test/modes/host-services.test.ts b/packages/coding-agent/test/modes/host-services.test.ts
new file mode 100644
index 0000000000..0b7243ee27
--- /dev/null
+++ b/packages/coding-agent/test/modes/host-services.test.ts
@@ -0,0 +1,191 @@
+import { describe, expect, it } from "bun:test";
+import {
+	type DashboardResourceRequest,
+	type HostServiceCancel,
+	RemoteHostServices,
+	type HostServiceOrigin,
+	type HostServiceRequest,
+} from "../../src/modes/host-services";
+
+const origin: HostServiceOrigin = { requestId: "event-1", viewId: "view-1", transportId: "transport-1" };
+const peerId = "50f03972-14f2-4b88-98a2-8b475c422bc6";
+
+function channel() {
+	const requests: HostServiceRequest[] = [];
+	const cancels: HostServiceCancel[] = [];
+	const dashboardResources: DashboardResourceRequest[] = [];
+	return {
+		requests,
+		cancels,
+		dashboardResources,
+		channel: {
+			send: (request: HostServiceRequest) => {
+				requests.push(request);
+			},
+			cancel: (request: HostServiceCancel) => {
+				cancels.push(request);
+			},
+			dashboardResource: (request: DashboardResourceRequest) => {
+				dashboardResources.push(request);
+			},
+		},
+	};
+}
+
+describe("RemoteHostServices", () => {
+	it("settles only the matching service request from its originating view and transport", async () => {
+		const harness = channel();
+		const services = new RemoteHostServices(harness.channel);
+		const result = services.run(origin, () => services.adapter.copyText("private clipboard payload"));
+		const request = harness.requests[0];
+		if (!request) throw new Error("host service request was not sent");
+		expect(request.origin).toEqual(origin);
+		expect(request.kind).toBe("copy_text");
+		expect(request.value).toBe("private clipboard payload");
+		expect(
+			services.reply({
+				serviceId: request.serviceId,
+				origin: { ...origin, viewId: "other-view" },
+				accepted: true,
+			}),
+		).toBe(false);
+		expect(
+			services.reply({
+				serviceId: request.serviceId,
+				origin: { ...origin, transportId: "stale-transport" },
+				accepted: true,
+			}),
+		).toBe(false);
+		let settled = false;
+		void result.then(() => {
+			settled = true;
+		});
+		await Promise.resolve();
+		expect(settled).toBe(false);
+		expect(services.reply({ serviceId: request.serviceId, origin, accepted: true })).toBe(true);
+		await result;
+		// A duplicate reply is consumed once and cannot settle a later request.
+		expect(services.reply({ serviceId: request.serviceId, origin, accepted: true })).toBe(false);
+		services.dispose();
+	});
+
+	it("rejects failed browser services and refuses effects outside a view action", async () => {
+		const harness = channel();
+		const services = new RemoteHostServices(harness.channel);
+		await expect(services.adapter.openUrl("https://example.com")).rejects.toThrow("view-owned user action");
+		const result = services.run(origin, () => services.adapter.openUrl("https://example.com"));
+		const request = harness.requests[0];
+		if (!request) throw new Error("host service request was not sent");
+		expect(request.kind).toBe("open_url");
+		expect(harness.requests.length).toBe(1);
+		expect(services.reply({ serviceId: request.serviceId, origin, accepted: false, error: "popup blocked" })).toBe(
+			true,
+		);
+		await expect(result).rejects.toThrow("popup blocked");
+		services.dispose();
+	});
+
+	it("withdraws every outstanding request when the hosted view is disposed", async () => {
+		const harness = channel();
+		const services = new RemoteHostServices(harness.channel);
+		const result = services.run(origin, () => services.adapter.copyText("text"));
+		services.dispose();
+		expect(harness.cancels).toHaveLength(1);
+		expect(harness.cancels[0]).toMatchObject({ origin, kind: "copy_text" });
+		expect(harness.cancels[0]).not.toHaveProperty("value");
+		await expect(result).rejects.toThrow("closed before the host service completed");
+	});
+
+	it("withdraws a request the browser never answered before its timeout", async () => {
+		const harness = channel();
+		const services = new RemoteHostServices(harness.channel, 5);
+		const result = services.run(origin, () => services.adapter.openUrl("https://example.com"));
+		await expect(result).rejects.toThrow("timed out");
+		expect(harness.cancels).toHaveLength(1);
+		expect(harness.cancels[0]).toMatchObject({ kind: "open_url", origin });
+		services.dispose();
+	});
+
+	it("bounds pending work and value sizes without sending anything", async () => {
+		const harness = channel();
+		const services = new RemoteHostServices(harness.channel);
+		const pending = Array.from({ length: 32 }, () => services.run(origin, () => services.adapter.copyText("x")));
+		expect(harness.requests).toHaveLength(32);
+		await expect(services.run(origin, () => services.adapter.copyText("x"))).rejects.toThrow("Too many pending");
+		expect(harness.requests).toHaveLength(32);
+		await expect(services.run(origin, () => services.adapter.copyText("x".repeat(1024 * 1024 + 1)))).rejects.toThrow(
+			"size limit",
+		);
+		expect(harness.requests).toHaveLength(32);
+		for (const request of harness.requests) {
+			services.reply({ serviceId: request.serviceId, origin, accepted: true });
+		}
+		await Promise.all(pending);
+		services.dispose();
+		expect(harness.cancels).toHaveLength(0);
+	});
+
+	it("rejects an oversized browser error without leaking it whole", async () => {
+		const harness = channel();
+		const services = new RemoteHostServices(harness.channel);
+		const result = services.run(origin, () => services.adapter.copyText("x"));
+		const request = harness.requests[0];
+		if (!request) throw new Error("host service request was not sent");
+		services.reply({ serviceId: request.serviceId, origin, accepted: false, error: "e".repeat(4096) });
+		await expect(result).rejects.toThrow(/^e{512}$/);
+		services.dispose();
+	});
+
+	it("returns SDP only to the matching browser live preparation", async () => {
+		const harness = channel();
+		const services = new RemoteHostServices(harness.channel);
+		const abort = new AbortController();
+		const result = services.run(origin, () => services.adapter.liveAudio.prepare(peerId, abort.signal));
+		const request = harness.requests[0];
+		if (!request) throw new Error("live preparation was not sent");
+		expect(request.kind).toBe("live_audio");
+		expect(JSON.parse(request.value)).toEqual({ op: "prepare", peerId });
+		expect(services.reply({
+			serviceId: request.serviceId, origin: { ...origin, viewId: "other-view" },
+			accepted: true, value: "v=0\r\n",
+		})).toBe(false);
+		expect(services.reply({ serviceId: request.serviceId, origin, accepted: true, value: "v=0\r\n" })).toBe(true);
+		await expect(result).resolves.toBe("v=0\r\n");
+		services.dispose();
+	});
+
+	it("withdraws pending live permission work on Stop and rejects a stale answer", async () => {
+		const harness = channel();
+		const services = new RemoteHostServices(harness.channel);
+		const abort = new AbortController();
+		const result = services.run(origin, () => services.adapter.liveAudio.connect(peerId, "answer", abort.signal));
+		const request = harness.requests[0];
+		if (!request) throw new Error("live connection was not sent");
+		abort.abort(new Error("Stopped"));
+		await expect(result).rejects.toThrow("Stopped");
+		expect(harness.cancels).toEqual([{ serviceId: request.serviceId, origin, kind: "live_audio" }]);
+		expect(services.reply({ serviceId: request.serviceId, origin, accepted: true })).toBe(false);
+		services.dispose();
+	});
+
+	it("rejects missing or oversized SDP and values returned for void host effects", async () => {
+		for (const value of [undefined, "", "s".repeat(128 * 1024 + 1)]) {
+			const harness = channel();
+			const services = new RemoteHostServices(harness.channel);
+			const result = services.run(origin, () => services.adapter.liveAudio.prepare(peerId, new AbortController().signal));
+			const request = harness.requests[0];
+			if (!request) throw new Error("live preparation was not sent");
+			services.reply({ serviceId: request.serviceId, origin, accepted: true, value });
+			await expect(result).rejects.toThrow("invalid host-service result");
+			services.dispose();
+		}
+		const harness = channel();
+		const services = new RemoteHostServices(harness.channel);
+		const result = services.run(origin, () => services.adapter.copyText("text"));
+		const request = harness.requests[0];
+		if (!request) throw new Error("copy was not sent");
+		services.reply({ serviceId: request.serviceId, origin, accepted: true, value: "unexpected" });
+		await expect(result).rejects.toThrow("invalid host-service result");
+		services.dispose();
+	});
+});
