+} from "../src/overlays/plugin-settings";
+import type { NativeNode } from "../src/native/node";
+import { getThemeByName, setThemeInstance } from "../src/theme";
+
+const manager: PluginSettingsManager = {
+	list: async () => [],
+	getPlugin: async () => undefined,
+	getPluginSettings: async () => ({}),
+	setEnabled: async () => {},
+	getEnabledFeatures: async () => null,
+	setEnabledFeatures: async () => {},
+	setPluginSetting: async () => {},
+};
+
+const callbacks = {
+	onEnabledChange: () => {},
+	onFeatureChange: () => {},
+	onConfigChange: () => {},
+	onBack: () => {},
+};
+
+describe("plugin detail native page", () => {
+	beforeAll(async () => {
+		const theme = await getThemeByName("dark");
+		if (!theme) throw new Error("theme unavailable");
+		setThemeInstance(theme);
+	});
+
+	const build = async (description: string | undefined) => {
+		const plugin: InstalledPlugin = {
+			name: "demo",
+			version: "1.0.0",
+			enabled: true,
+			enabledFeatures: null,
+			manifest: { description },
+		};
+		const detail = new PluginDetailComponent(plugin, manager, callbacks);
+		await Promise.resolve();
+		await Promise.resolve();
+		return detail.prefsPage();
+	};
+
+	it("heads the list with the manifest description the terminal draws above it", async () => {
+		const page = await build("Demo plugin description");
+		expect(page.sections.map(section => section.title)).toEqual(["Demo plugin description"]);
+		expect("lead" in page).toBe(false);
+	});
+
+	it("adds no heading when the terminal draws no description", async () => {
+		const page = await build(undefined);
+		expect(page.sections.map(section => section.title)).toEqual([""]);
+	});
+
+	it("follows a marketplace plugin's list with the dim summary lines the terminal draws", () => {
+		const detail = new MarketplacePluginDetailComponent(
+			{
+				id: "demo@market",
+				scope: "user",
+				entries: [
+					{
+						installPath: "/tmp/demo",
+						version: "1.2.3",
+						installedAt: "2024-01-01",
+						lastUpdated: "2024-02-02",
+						gitCommitSha: "abc123",
+					},
+				],
+			},
+			manager,
+			{ ...callbacks, parsePluginId: () => null },
+		);
+		const page = detail.prefsPage();
+		expect(page.sections.map(section => section.title)).toEqual(["[user]"]);
+		const summary = page.summary as NativeNode;
+		expect(summary.p).toEqual({ role: "omp.prefs.summary" });
+		expect(summary.c?.map(line => (line as NativeNode).p)).toEqual(
+			[
+				"version       1.2.3",
+				"scope         user",
+				"install path  /tmp/demo",
+				"installed at  2024-01-01",
+				"last updated  2024-02-02",
+				"git sha       abc123",
+			].map(line => ({ spans: [{ t: line, s: "dim" }] })),
+		);
+	});
+
+	it("draws no summary for a plugin without one", async () => {
+		expect((await build("Demo plugin description")).summary).toBeUndefined();
+	});
+});
