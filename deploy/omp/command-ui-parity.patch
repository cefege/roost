index 0000000000..b0b311090c
--- /dev/null
+++ b/packages/tui/test/native/theme-palette.test.ts
@@ -0,0 +1,103 @@
+import { afterEach, describe, expect, it } from "bun:test";
+import { Text } from "../../src/components/text";
+import { styledSpans } from "../../src/native/spans";
+import { createTheme } from "../../src/theme/loader";
+import darkThemeJson from "../../src/theme/dark.json" with { type: "json" };
+import {
+	getCurrentThemeName,
+	initThemeSync,
+	onThemeChange,
+	previewTheme,
+	setTheme,
+	setThemeInstance,
+	theme,
+} from "../../src/theme/theme";
+import { TUI } from "../../src/tui";
+import { TSP_KINDS, TSP_VERSION, type TspPalette } from "@oh-my-pi/pi-wire";
+import { ManualScheduler, TspTestTerminal } from "./tsp-harness";
+
+const hello = { r: "hello" as const, v: TSP_VERSION, term: "acp", kinds: TSP_KINDS, cols: 80 };
+let tui: TUI | undefined;
+let disposeListener: (() => void) | undefined;
+afterEach(() => {
+	tui?.stop();
+	tui = undefined;
+	disposeListener?.();
+	disposeListener = undefined;
+	initThemeSync();
+});
+
+function open() {
+	const messages: { verb: string; body: unknown }[] = [];
+	tui = new TUI(new TspTestTerminal({}), false, {
+		renderScheduler: new ManualScheduler(),
+		nativeSend: message => messages.push(message),
+	});
+	tui.addChild(new Text("actual native theme", 0, 0));
+	tui.startNative(hello);
+	const palettes = () => messages.filter(message => message.verb === "t").map(message => message.body as TspPalette);
+	return { messages, palettes };
+}
+
+describe("actual native Theme palette publication", () => {
+	it("publishes initial and in-memory colors without replacing the UI listener, then disposes", () => {
+		initThemeSync();
+		let notifications = 0;
+		disposeListener = onThemeChange(() => {
+			notifications++;
+		});
+		const view = open();
+		expect(view.palettes().at(-1)?.colors).toEqual(theme.getResolvedColors());
+		const active = createTheme(
+			{ ...darkThemeJson, colors: { ...darkThemeJson.colors, accent: "#123456", userMessageBg: "#345678" } },
+			{ mode: "truecolor" },
+		);
+		const before = notifications;
+		setThemeInstance(active);
+		expect(notifications).toBeGreaterThan(before);
+		expect(view.palettes().at(-1)?.colors.accent).toBe("#123456");
+		expect(view.palettes().at(-1)?.colors.userMessageBg).toBe("#345678");
+		tui!.stop();
+		const sent = view.palettes().length;
+		setThemeInstance(createTheme(darkThemeJson, { mode: "truecolor" }));
+		expect(view.palettes()).toHaveLength(sent);
+	});
+
+	it("replays the live preview on reconnect and publishes the actual failed-load fallback", async () => {
+		await setTheme("dark");
+		const view = open();
+		expect((await previewTheme("light")).success).toBe(true);
+		expect(getCurrentThemeName()).toBe("dark");
+		const previewColors = theme.getResolvedColors();
+		expect(view.palettes().at(-1)?.colors).toEqual(previewColors);
+		view.messages.length = 0;
+		tui!.resetNative(hello);
+		expect(view.palettes().at(-1)?.colors).toEqual(previewColors);
+		expect(theme.getResolvedColors()).toEqual(previewColors);
+		expect(view.messages.findIndex(message => message.verb === "t")).toBeLessThan(
+			view.messages.findIndex(message => message.verb === "f"),
+		);
+		expect((await setTheme("native-palette-missing-theme")).success).toBe(false);
+		expect(getCurrentThemeName()).toBe("dark");
+		expect(view.palettes().at(-1)?.colors).toEqual(theme.getResolvedColors());
+	});
+
+	it("retains explicit text and ordinary background spans but never fabricates terminal reset RGB", () => {
+		const active = createTheme(
+			{ ...darkThemeJson, colors: { ...darkThemeJson.colors, text: "#123456", userMessageBg: "#345678" } },
+			{ mode: "truecolor" },
+		);
+		setThemeInstance(active);
+		expect(styledSpans(active.fg("text", "text"))[0]?.s).toBe("text");
+		expect(styledSpans(active.bgFill("userMessageBg", "field"))[0]?.s).toContain("bg:userMessageBg");
+		expect(styledSpans(active.bgFill("userMessageBg", "field"), { background: false })[0]?.s ?? "").not.toContain(
+			"bg:userMessageBg",
+		);
+		const ambient = createTheme(
+			{ ...darkThemeJson, colors: { ...darkThemeJson.colors, text: "", userMessageBg: "" } },
+			{ mode: "truecolor" },
+		);
+		expect(ambient.getResolvedColors()).not.toHaveProperty("text");
+		expect(ambient.getResolvedColors()).not.toHaveProperty("userMessageBg");
+	});
+});
