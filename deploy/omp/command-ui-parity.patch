index 0000000000..f0419a2d5f
--- /dev/null
+++ b/packages/coding-agent/src/modes/host-services.ts
@@ -0,0 +1,318 @@
+import type { StatsServerHandle } from "@oh-my-pi/omp-stats";
+import { randomUUID } from "node:crypto";
+import { AsyncLocalStorage } from "node:async_hooks";
+import type { InteractiveHostServices } from "./types";
+
+/**
+ * Routing identity of the native action that asked for a browser-owned effect.
+ * It is the worker-issued envelope; a child view can never retarget another one.
+ */
+export interface HostServiceOrigin {
+	readonly requestId: string;
+	readonly viewId: string;
+	readonly transportId: string;
+}
+
+export type HostServiceKind = "copy_text" | "open_url" | "open_stats_dashboard" | "open_fork" | "live_audio";
+
+export interface HostServiceRequest {
+	readonly serviceId: string;
+	readonly origin: HostServiceOrigin;
+	readonly kind: HostServiceKind;
+	readonly value: string;
+}
+
+/** Withdraws a request the browser may still be showing; it carries no value. */
+export interface HostServiceCancel {
+	readonly serviceId: string;
+	readonly origin: HostServiceOrigin;
+	readonly kind: HostServiceKind;
+}
+
+export interface DashboardResourceRequest {
+	readonly resourceId: string;
+	readonly url: string;
+	readonly active: boolean;
+	readonly origin: HostServiceOrigin;
+}
+
+export interface HostServiceReply {
+	readonly serviceId: string;
+	readonly origin: HostServiceOrigin;
+	readonly accepted: boolean;
+	readonly error?: string;
+	readonly value?: string;
+}
+
+export interface HostServiceChannel {
+	send(request: HostServiceRequest): void;
+	cancel(request: HostServiceCancel): void;
+	dashboardResource(request: DashboardResourceRequest): void;
+	forkSession?(placement: "pane" | "window"): Promise<{ sessionId: string; parentSessionId: string }>;
+}
+
+const MAX_PENDING = 32;
+const REQUEST_TIMEOUT_MS = 30_000;
+/** Matches the coordinator and browser host-service frame cap (1 MiB). */
+const MAX_COPY_BYTES = 1024 * 1024;
+/** URLs stay small; this is the native prompt's own bound. */
+const MAX_URL_BYTES = 8 * 1024;
+const MAX_ERROR_BYTES = 512;
+const MAX_LIVE_AUDIO_BYTES = 128 * 1024;
+
+interface PendingRequest {
+	readonly origin: HostServiceOrigin;
+	readonly kind: HostServiceKind;
+	readonly resolve: (value: string | undefined) => void;
+	readonly reject: (error: Error) => void;
+	readonly expectsValue: boolean;
+	readonly signal: AbortSignal | undefined;
+	readonly onAbort: (() => void) | undefined;
+	timer: NodeJS.Timeout;
+}
+
+/**
+ * Routes browser-owned effects through the view whose native action requested
+ * them. Pending state is bounded, every promise is settled exactly once, and a
+ * reply is accepted only from the origin that created the request.
+ */
+export class RemoteHostServices {
+	readonly #origin = new AsyncLocalStorage<HostServiceOrigin>();
+	readonly #pending = new Map<string, PendingRequest>();
+	readonly #channel: HostServiceChannel;
+	readonly #dashboards = new Map<string, { revoke: () => void }>();
+	readonly #timeoutMs: number;
+	#disposed = false;
+
+	constructor(channel: HostServiceChannel, timeoutMs = REQUEST_TIMEOUT_MS) {
+		this.#channel = channel;
+		this.#timeoutMs = timeoutMs;
+	}
+
+	readonly adapter: InteractiveHostServices = {
+		copyText: async (text: string) => {
+			await this.#request("copy_text", text);
+		},
+		openUrl: async (url: string) => {
+			await this.#request("open_url", url);
+		},
+		openFork: async (placement: "pane" | "window") => {
+			if (!this.#origin.getStore()) throw new Error("Host services require a view-owned user action.");
+			if (this.#disposed) throw new Error("The remote command UI is closed.");
+			if (!this.#channel.forkSession) throw new Error("The hosted session cannot fork.");
+			const fork = await this.#channel.forkSession(placement);
+			await this.#request("open_fork", JSON.stringify({ ...fork, placement }));
+		},
+		openStatsDashboard: async (server: StatsServerHandle, url: string) => {
+			const origin = this.#origin.getStore();
+			if (!origin) throw new Error("Host services require a view-owned user action.");
+			const address = new URL(url);
+			const hostname = server.hostname.includes(":") ? `[${server.hostname}]` : server.hostname;
+			if (
+				!server.resourceId || !server.onStop ||
+				!isStatsBridgeOrigin(address.origin) ||
+				address.origin !== `http://${hostname}:${server.port}` ||
+				address.pathname !== "/" || address.search !== "" ||
+				(address.hash !== "" && !/^#\/traces\?s=[^&]+$/.test(address.hash))
+			) throw new Error("The stats dashboard is not owned by this OMP process.");
+			const resourceId = server.resourceId;
+			if (!this.#dashboards.has(resourceId)) {
+				this.#channel.dashboardResource({ resourceId, url: address.origin, active: true, origin });
+				let stopped = false;
+				const unsubscribe = server.onStop(() => {
+					stopped = true;
+					this.#channel.dashboardResource({ resourceId, url: address.origin, active: false, origin });
+					this.#dashboards.delete(resourceId);
+				});
+				if (stopped) throw new Error("The stats dashboard is no longer running.");
+				this.#dashboards.set(resourceId, { revoke: () => {
+					unsubscribe();
+					this.#channel.dashboardResource({ resourceId, url: address.origin, active: false, origin });
+				} });
+			}
+			await this.#request("open_stats_dashboard", JSON.stringify({ resourceId, origin: address.origin, fragment: address.hash }));
+		},
+		liveAudio: {
+			prepare: async (peerId, signal) => {
+				const offer = await this.#request("live_audio", JSON.stringify({ op: "prepare", peerId }), true, signal);
+				if (offer === undefined) throw new Error("The browser did not return a live SDP offer.");
+				return offer;
+			},
+			connect: async (peerId, sdpAnswer, signal) => {
+				await this.#request("live_audio", JSON.stringify({ op: "connect", peerId, sdpAnswer }), false, signal);
+			},
+			mute: async (peerId, muted) => {
+				await this.#request("live_audio", JSON.stringify({ op: "mute", peerId, muted }));
+			},
+			close: async peerId => {
+				await this.#request("live_audio", JSON.stringify({ op: "close", peerId }));
+			},
+		},
+	};
+
+	/** Run one native action so its asynchronous callbacks keep the same origin. */
+	run<T>(origin: HostServiceOrigin, callback: () => T): T {
+		return this.#origin.run(origin, callback);
+	}
+
+	/** Settle a pending request from the browser; false means it was not this request's owner. */
+	reply(reply: HostServiceReply): boolean {
+		const pending = this.#pending.get(reply.serviceId);
+		if (
+			!pending ||
+			pending.origin.requestId !== reply.origin.requestId ||
+			pending.origin.viewId !== reply.origin.viewId ||
+			pending.origin.transportId !== reply.origin.transportId
+		) {
+			return false;
+		}
+		this.#settle(reply.serviceId, pending);
+		if (!reply.accepted) {
+			pending.reject(new Error(boundedError(reply.error)));
+		} else if (
+			pending.expectsValue
+				? typeof reply.value !== "string" || !reply.value.trim() || Buffer.byteLength(reply.value) > MAX_LIVE_AUDIO_BYTES
+				: reply.value !== undefined
+		) {
+			pending.reject(new Error("The browser returned an invalid host-service result."));
+		} else {
+			pending.resolve(reply.value);
+		}
+		return true;
+	}
+
+	/** Reject outstanding work and withdraw its browser prompts (view closed). */
+	cancelPending(reason: string): void {
+		for (const [serviceId, pending] of this.#pending) {
+			this.#settle(serviceId, pending);
+			this.#notifyCancel(serviceId, pending);
+			pending.reject(new Error(reason));
+		}
+		this.#pending.clear();
+		for (const resource of this.#dashboards.values()) resource.revoke();
+		this.#dashboards.clear();
+	}
+
+	dispose(): void {
+		if (this.#disposed) return;
+		this.#disposed = true;
+		this.cancelPending("The remote command UI closed before the host service completed.");
+	}
+
+	#settle(serviceId: string, pending: PendingRequest): void {
+		this.#pending.delete(serviceId);
+		clearTimeout(pending.timer);
+		if (pending.onAbort) pending.signal?.removeEventListener("abort", pending.onAbort);
+	}
+
+	#notifyCancel(serviceId: string, pending: PendingRequest): void {
+		try {
+			this.#channel.cancel({ serviceId, origin: pending.origin, kind: pending.kind });
+		} catch {
+			// The view is already gone; the worker withdraws the request on its own.
+		}
+	}
+
+	#request(
+		kind: HostServiceKind,
+		value: string,
+		expectsValue = false,
+		signal?: AbortSignal,
+	): Promise<string | undefined> {
+		const origin = this.#origin.getStore();
+		if (!origin) return Promise.reject(new Error("Host services require a view-owned user action."));
+		if (this.#disposed) return Promise.reject(new Error("The remote command UI is closed."));
+		if (signal?.aborted) return Promise.reject(abortError(signal));
+		const limit = kind === "copy_text" ? MAX_COPY_BYTES : kind === "live_audio" ? MAX_LIVE_AUDIO_BYTES : MAX_URL_BYTES;
+		if (Buffer.byteLength(value) > limit) {
+			return Promise.reject(new Error("The host service value exceeds its size limit."));
+		}
+		if (this.#pending.size >= MAX_PENDING) {
+			return Promise.reject(new Error("Too many pending host services."));
+		}
+		const serviceId = randomUUID();
+		const { promise, resolve, reject } = Promise.withResolvers<string | undefined>();
+		const onAbort = signal ? () => {
+			const pending = this.#pending.get(serviceId);
+			if (!pending) return;
+			this.#settle(serviceId, pending);
+			this.#notifyCancel(serviceId, pending);
+			reject(abortError(signal));
+		} : undefined;
+		const timer = setTimeout(() => {
+			const pending = this.#pending.get(serviceId);
+			if (!pending) return;
+			this.#settle(serviceId, pending);
+			this.#notifyCancel(serviceId, pending);
+			reject(new Error("The browser host service timed out."));
+		}, this.#timeoutMs);
+		this.#pending.set(serviceId, { origin, kind, resolve, reject, timer, expectsValue, signal, onAbort });
+		if (onAbort) signal?.addEventListener("abort", onAbort, { once: true });
+		try {
+			this.#channel.send({ serviceId, origin, kind, value });
+		} catch (error) {
+			const pending = this.#pending.get(serviceId);
+			if (pending) this.#settle(serviceId, pending);
+			reject(error instanceof Error ? error : new Error(String(error)));
+		}
+		return promise;
+	}
+}
+
+/**
+ * The native `/stats` helper reports one bare origin. Whether that host is
+ * actually assigned to the worker is proved by the worker's bind probe before
+ * it dials; the native side only rejects a shape that is not an origin.
+ */
+export function isStatsBridgeOrigin(url: string): boolean {
+	try {
+		const parsed = new URL(url);
+		return (
+			parsed.protocol === "http:" &&
+			parsed.pathname === "/" &&
+			parsed.search === "" &&
+			parsed.hash === "" &&
+			parsed.username === "" &&
+			parsed.password === "" &&
+			parsed.hostname.length > 0
+		);
+	} catch {
+		return false;
+	}
+}
+
+export function isHostServiceOrigin(value: unknown): value is HostServiceOrigin {
+	if (!value || typeof value !== "object") return false;
+	const origin = value as Partial<HostServiceOrigin>;
+	return (
+		typeof origin.requestId === "string" &&
+		origin.requestId.length > 0 &&
+		typeof origin.viewId === "string" &&
+		origin.viewId.length > 0 &&
+		typeof origin.transportId === "string" &&
+		origin.transportId.length > 0
+	);
+}
+
+export function isHostServiceReply(value: unknown): value is HostServiceReply {
+	if (!value || typeof value !== "object") return false;
+	const reply = value as Partial<HostServiceReply>;
+	return (
+		typeof reply.serviceId === "string" &&
+		reply.serviceId.length > 0 &&
+		isHostServiceOrigin(reply.origin) &&
+		typeof reply.accepted === "boolean" &&
+		(reply.error === undefined || typeof reply.error === "string") &&
+		(reply.value === undefined || typeof reply.value === "string")
+	);
+}
+
+function boundedError(error: string | undefined): string {
+	const message = error?.trim();
+	if (!message) return "The browser did not accept this host service.";
+	return message.length > MAX_ERROR_BYTES ? message.slice(0, MAX_ERROR_BYTES) : message;
+}
+
+function abortError(signal: AbortSignal): Error {
+	return signal.reason instanceof Error ? signal.reason : new Error("The live call was cancelled.");
+}
