+import { VERSION } from "@oh-my-pi/pi-utils";
+import { Composer } from "@oh-my-pi/pi-tui/prompt/composer";
+import { ProcessTerminal, type Terminal, type TerminalAppearance } from "@oh-my-pi/pi-tui/terminal";
+import type { NativeTransportMessage } from "@oh-my-pi/pi-tui/native/backend";
+import { encodeTspJson, type TspHello } from "@oh-my-pi/pi-tui/native/encode";
+import { TSP_KINDS, TSP_VERSION, type TspEvent } from "@oh-my-pi/pi-wire";
+import type { AgentSession } from "../../session/agent-session";
+import { submitInteractiveInput } from "../../main";
+import { InteractiveMode } from "../interactive-mode";
+import {
+	RemoteHostServices,
+	type HostServiceChannel,
+	type HostServiceOrigin,
+	type HostServiceReply,
+} from "../host-services";
+
+export interface RemoteCommandUiOpen {
+	readonly cols: number;
+	readonly rows: number;
+	readonly dark: boolean;
+	readonly reduceMotion: boolean;
+	readonly kinds?: readonly string[];
+	readonly features?: readonly string[];
+	readonly transportId?: string;
+}
+export interface RemoteCommandUiState {
+	readonly resumeId: string;
+	readonly cwd: string;
+	readonly streaming: boolean;
+	readonly restartRequested?: true;
+	readonly resetHistory?: true;
+	readonly stopReason?: string;
+	readonly error?: string;
+}
+
+/** A terminal adapter that lets the existing interactive controllers run without acquiring a tty. */
+class RemoteTerminal extends ProcessTerminal {
+	#cols: number;
+	#rows: number;
+	#appearance: TerminalAppearance;
+
+	constructor(open: RemoteCommandUiOpen) {
+		super();
+		this.#cols = open.cols;
+		this.#rows = open.rows;
+		this.#appearance = open.dark ? "dark" : "light";
+	}
+
+	override start(): void {}
+	override stop(): void {}
+	override write(): void {}
+	override drainInput(): Promise<void> {
+		return Promise.resolve();
+	}
+	override get columns(): number {
+		return this.#cols;
+	}
+	override get rows(): number {
+		return this.#rows;
+	}
+	override get appearance(): TerminalAppearance {
+		return this.#appearance;
+	}
+	override onAppearanceChange(): void {}
+
+	resize(cols: number, rows: number): void {
+		this.#cols = cols;
+		this.#rows = rows;
+	}
+
+	setAppearance(dark: boolean): void {
+		this.#appearance = dark ? "dark" : "light";
+	}
+}
+
+/** Owns one remote view over the ACP record's canonical AgentSession. */
+export class RemoteCommandUi {
+	readonly mode: InteractiveMode;
+	readonly #terminal: RemoteTerminal;
+	readonly #send: (message: NativeTransportMessage, transportId: string) => void;
+	readonly #onState: (state: RemoteCommandUiState) => void | Promise<void>;
+	#closeRequested = false;
+	#opened = false;
+	#disposed = false;
+	#nativeStarted = false;
+	#forceHistoryReset = true;
+	#transportId = "";
+	#inputLoop: Promise<void> | undefined;
+	#opening: Promise<void> | undefined;
+	#commandPending = false;
+	#lastResumeId: string;
+	#lastStreaming: boolean;
+	#lastCwd: string;
+	#stateDelivery: Promise<void> | undefined;
+	readonly #hostServices: RemoteHostServices;
+	#unsubscribeRunState: () => void;
+	#unsubscribeSessionChange: () => void;
+
+	constructor(
+		session: AgentSession,
+		send: (message: NativeTransportMessage, transportId: string) => void,
+		onState: (state: RemoteCommandUiState) => void | Promise<void>,
+		initial: RemoteCommandUiOpen,
+		sendHostService: HostServiceChannel,
+	) {
+		this.#terminal = new RemoteTerminal(initial);
+		this.#send = send;
+		this.#onState = onState;
+		this.#hostServices = new RemoteHostServices(sendHostService);
+		this.#lastResumeId = session.sessionManager.getSessionId();
+		this.#lastCwd = session.sessionManager.getCwd();
+		this.#lastStreaming = session.isStreaming;
+		const composer = new Composer({
+			terminal: this.#terminal as Terminal,
+			tuiOptions: {
+				nativeSend: message => {
+					this.#send(message, this.#transportId);
+					// ACP has no shared terminal blob cache; transfer each blob inline.
+					if (
+						message.verb === "q" &&
+						typeof message.body === "object" &&
+						message.body !== null &&
+						"q" in message.body &&
+						message.body.q === "blobs"
+					) {
+						queueMicrotask(() => {
+							if (!this.#disposed) this.mode.ui.handleRemoteInput(encodeTspJson("r", { r: "blobs", have: [] }));
+						});
+					}
+				},
+			},
+			preferences: { quiet: true },
+			exit: () => {},
+		});
+		this.mode = new InteractiveMode(
+			session,
+			VERSION,
+			undefined,
+			undefined,
+			undefined,
+			undefined,
+			undefined,
+			composer,
+			undefined,
+			undefined,
+			true,
+			() => void this.close(),
+			async () => this.publishState(true),
+			this.#hostServices.adapter,
+		);
+		this.#unsubscribeRunState = session.subscribeRunState(() => {
+			void this.publishState().catch(() => {});
+		});
+		this.#unsubscribeSessionChange = session.registerSessionChangeCallback(() => {
+			void this.publishState().catch(() => {});
+		});
+	}
+
+	get transportId(): string {
+		return this.#transportId;
+	}
+
+	async open(options: RemoteCommandUiOpen, origin?: HostServiceOrigin): Promise<void> {
+		if (this.#disposed) throw new Error("Remote command UI is disposed");
+		if (this.#opening) {
+			await this.#opening;
+			return this.open(options, origin);
+		}
+		this.#closeRequested = false;
+		this.#forceHistoryReset = true;
+		const opening = origin
+			? this.#hostServices.run(origin, () => this.#initialize(options))
+			: this.#initialize(options);
+		this.#opening = opening;
+		try {
+			await opening;
+		} finally {
+			if (this.#opening === opening) this.#opening = undefined;
+		}
+	}
+
+	async #initialize(options: RemoteCommandUiOpen): Promise<void> {
+		this.#terminal.resize(options.cols, options.rows);
+		this.#terminal.setAppearance(options.dark);
+		if (!this.mode.isInitialized) {
+			await this.mode.init({ suppressWelcomeIntro: true });
+			await this.mode.renderInitialMessages({ preserveExistingChat: true });
+		}
+		if (this.#disposed || this.#closeRequested) return;
+		const hello: TspHello = {
+			r: "hello",
+			v: TSP_VERSION,
+			term: "acp",
+			kinds: options.kinds ?? TSP_KINDS,
+			features: options.features ?? [],
+			cols: options.cols,
+			dark: options.dark,
+			reduceMotion: options.reduceMotion,
+		};
+		this.#transportId = options.transportId ?? crypto.randomUUID();
+		if (this.#nativeStarted) this.mode.ui.resetNative(hello);
+		else this.mode.ui.startNative(hello);
+		this.#nativeStarted = true;
+		this.#opened = true;
+		if (!this.#inputLoop) this.#inputLoop = this.#runInputLoop();
+		await this.publishState();
+	}
+
+	event(event: TspEvent, origin?: HostServiceOrigin): void {
+		if (!this.#opened || this.#disposed) return;
+		const dispatch = () => {
+			if (event.ev === "resize") {
+				this.#terminal.resize(event.cols, this.#terminal.rows);
+				this.mode.ui.dispatchNativeEvent(event);
+				this.mode.ui.flushNativeFrames();
+				return;
+			}
+			if (event.ev === "theme") this.#terminal.setAppearance(event.dark);
+			this.mode.ui.dispatchNativeEvent(event);
+			this.mode.ui.flushNativeFrames();
+		};
+		if (origin) this.#hostServices.run(origin, dispatch);
+		else dispatch();
+	}
+
+	/**
+	 * Apply one key sequence. A browser-side caret edit rides along as `before`
+	 * and must land first, in the same origin, so the two RPCs cannot reorder.
+	 */
+	input(data: string, origin?: HostServiceOrigin, before?: TspEvent): void {
+		if (!this.#opened || this.#disposed) return;
+		const dispatch = () => {
+			if (before) this.mode.ui.dispatchNativeEvent(before);
+			this.mode.ui.handleRemoteInput(data);
+			this.mode.ui.flushNativeFrames();
+		};
+		if (origin) this.#hostServices.run(origin, dispatch);
+		else dispatch();
+	}
+
+	async command(text: string, origin?: HostServiceOrigin): Promise<boolean> {
+		if (!this.#opened || this.#disposed) return false;
+		if (this.#commandPending) throw new Error("A remote command is already being submitted");
+		this.#commandPending = true;
+		try {
+			const dispatch = async () => {
+				this.mode.editor.setText(text);
+				this.mode.ui.handleRemoteInput("\r");
+				this.mode.ui.flushNativeFrames();
+				await this.mode.waitForSubmissionDispatches();
+				await this.publishState();
+			};
+			if (origin) await this.#hostServices.run(origin, dispatch);
+			else await dispatch();
+			return true;
+		} finally {
+			this.#commandPending = false;
+		}
+	}
+	hostServiceReply(reply: HostServiceReply): boolean {
+		return this.#hostServices.reply(reply);
+	}
+
+	async publishState(restartRequested = false): Promise<void> {
+		if (this.#disposed || !this.#nativeStarted) return;
+		const resumeId = this.mode.sessionManager.getSessionId();
+		const cwd = this.mode.sessionManager.getCwd();
+		const resetHistory = this.#forceHistoryReset || resumeId !== this.#lastResumeId || cwd !== this.#lastCwd;
+		this.#forceHistoryReset = false;
+		this.#lastResumeId = resumeId;
+		this.#lastCwd = cwd;
+		const streaming = this.mode.session.isStreaming;
+		const ended = this.#lastStreaming && !streaming;
+		this.#lastStreaming = streaming;
+		const lastAssistant = ended
+			? this.mode.session.agent.state.messages.findLast(message => message.role === "assistant")
+			: undefined;
+		const state: RemoteCommandUiState = {
+			resumeId,
+			cwd,
+			streaming,
+			...(resetHistory ? { resetHistory: true } : {}),
+			...(lastAssistant?.stopReason ? { stopReason: lastAssistant.stopReason } : {}),
+			...(lastAssistant?.stopReason === "error" && lastAssistant.errorMessage
+				? { error: lastAssistant.errorMessage }
+				: {}),
+			...(restartRequested ? { restartRequested: true as const } : {}),
+		};
+		const delivery = this.#stateDelivery
+			? this.#stateDelivery.then(() => this.#onState(state))
+			: Promise.resolve(this.#onState(state));
+		this.#stateDelivery = delivery;
+		try {
+			await delivery;
+		} catch (error) {
+			if (resetHistory) this.#forceHistoryReset = true;
+			throw error;
+		} finally {
+			if (this.#stateDelivery === delivery) this.#stateDelivery = undefined;
+		}
+	}
+
+	async close(): Promise<void> {
+		if (this.#disposed) return;
+		this.#closeRequested = true;
+		await this.#opening?.catch(() => {});
+		if (!this.#opened) return;
+		this.#opened = false;
+		this.#hostServices.cancelPending("The OMP view closed before the host service completed.");
+		this.mode.ui.closeNative();
+	}
+
+	async dispose(): Promise<void> {
+		if (this.#disposed) return;
+		await this.close();
+		this.#disposed = true;
+		this.#hostServices.dispose();
+		this.#unsubscribeRunState();
+		this.#unsubscribeSessionChange();
+		this.mode.stop();
+		await this.mode.ui.stop();
+	}
+
+	async #runInputLoop(): Promise<void> {
+		while (!this.#disposed) {
+			try {
+				const input = await this.mode.getUserInput();
+				await submitInteractiveInput(this.mode, this.mode.session, input);
+				await this.publishState();
+			} catch (error) {
+				if (this.#disposed) return;
+				this.mode.showError(error instanceof Error ? error.message : String(error));
+			}
+		}
+	}
+}
diff --git a/packages/coding-agent/src/modes/host-services.ts b/packages/coding-agent/src/modes/host-services.ts
new file mode 100644
index 0000000..9f52dc0
--- /dev/null
+++ b/packages/coding-agent/src/modes/host-services.ts
@@ -0,0 +1,226 @@
+import { randomUUID } from "node:crypto";
+import { AsyncLocalStorage } from "node:async_hooks";
+
+/**
+ * Routing identity of the native action that asked for a browser-owned effect.
+ * It is the worker-issued envelope; a child view can never retarget another one.
+ */
+export interface HostServiceOrigin {
+	readonly requestId: string;
+	readonly viewId: string;
+	readonly transportId: string;
+}
+
+export type HostServiceKind = "copy_text" | "open_url" | "open_stats_dashboard";
+
+export interface HostServiceRequest {
+	readonly serviceId: string;
+	readonly origin: HostServiceOrigin;
+	readonly kind: HostServiceKind;
+	readonly value: string;
+}
+
+/** Withdraws a request the browser may still be showing; it carries no value. */
+export interface HostServiceCancel {
+	readonly serviceId: string;
+	readonly origin: HostServiceOrigin;
+	readonly kind: HostServiceKind;
+}
+
+export interface HostServiceReply {
+	readonly serviceId: string;
+	readonly origin: HostServiceOrigin;
+	readonly accepted: boolean;
+	readonly error?: string;
+}
+
+export interface HostServiceChannel {
+	send(request: HostServiceRequest): void;
+	cancel(request: HostServiceCancel): void;
+}
+
+const MAX_PENDING = 32;
+const REQUEST_TIMEOUT_MS = 30_000;
+/** Matches the coordinator and browser host-service frame cap (1 MiB). */
+const MAX_COPY_BYTES = 1024 * 1024;
+/** URLs stay small; this is the native prompt's own bound. */
+const MAX_URL_BYTES = 8 * 1024;
+const MAX_ERROR_BYTES = 512;
+
+interface PendingRequest {
+	readonly origin: HostServiceOrigin;
+	readonly kind: HostServiceKind;
+	readonly resolve: () => void;
+	readonly reject: (error: Error) => void;
+	timer: ReturnType<typeof setTimeout>;
+}
+
+/**
+ * Routes browser-owned effects through the view whose native action requested
+ * them. Pending state is bounded, every promise is settled exactly once, and a
+ * reply is accepted only from the origin that created the request.
+ */
+export class RemoteHostServices {
+	readonly #origin = new AsyncLocalStorage<HostServiceOrigin>();
+	readonly #pending = new Map<string, PendingRequest>();
+	readonly #channel: HostServiceChannel;
+	readonly #timeoutMs: number;
+	#disposed = false;
+
+	constructor(channel: HostServiceChannel, timeoutMs = REQUEST_TIMEOUT_MS) {
+		this.#channel = channel;
+		this.#timeoutMs = timeoutMs;
+	}
+
+	readonly adapter = {
+		copyText: (text: string) => this.#request("copy_text", text),
+		openUrl: (url: string) => this.#request("open_url", url),
+		/**
+		 * Open the native stats dashboard in the hosted browser. A distinct
+		 * kind because a loopback URL here names the WORKER's dashboard; it
+		 * must never be treated as a generic provider callback the browser
+		 * cannot reach.
+		 */
+		openStatsDashboard: (url: string) => {
+			if (!isStatsBridgeOrigin(url)) {
+				return Promise.reject(new Error("The stats dashboard address is invalid."));
+			}
+			return this.#request("open_stats_dashboard", url);
+		},
+	};
+
+	/** Run one native action so its asynchronous callbacks keep the same origin. */
+	run<T>(origin: HostServiceOrigin, callback: () => T): T {
+		return this.#origin.run(origin, callback);
+	}
+
+	/** Settle a pending request from the browser; false means it was not this request's owner. */
+	reply(reply: HostServiceReply): boolean {
+		const pending = this.#pending.get(reply.serviceId);
+		if (
+			!pending ||
+			pending.origin.requestId !== reply.origin.requestId ||
+			pending.origin.viewId !== reply.origin.viewId ||
+			pending.origin.transportId !== reply.origin.transportId
+		) {
+			return false;
+		}
+		this.#settle(reply.serviceId, pending);
+		if (reply.accepted) pending.resolve();
+		else pending.reject(new Error(boundedError(reply.error)));
+		return true;
+	}
+
+	/** Reject outstanding work and withdraw its browser prompts (view closed). */
+	cancelPending(reason: string): void {
+		for (const [serviceId, pending] of this.#pending) {
+			clearTimeout(pending.timer);
+			this.#notifyCancel(serviceId, pending);
+			pending.reject(new Error(reason));
+		}
+		this.#pending.clear();
+	}
+
+	dispose(): void {
+		if (this.#disposed) return;
+		this.#disposed = true;
+		this.cancelPending("The remote command UI closed before the host service completed.");
+	}
+
+	#settle(serviceId: string, pending: PendingRequest): void {
+		this.#pending.delete(serviceId);
+		clearTimeout(pending.timer);
+	}
+
+	#notifyCancel(serviceId: string, pending: PendingRequest): void {
+		try {
+			this.#channel.cancel({ serviceId, origin: pending.origin, kind: pending.kind });
+		} catch {
+			// The view is already gone; the worker withdraws the request on its own.
+		}
+	}
+
+	#request(kind: HostServiceKind, value: string): Promise<void> {
+		const origin = this.#origin.getStore();
+		if (!origin) return Promise.reject(new Error("Host services require a view-owned user action."));
+		if (this.#disposed) return Promise.reject(new Error("The remote command UI is closed."));
+		const oversized = kind === "copy_text" ? MAX_COPY_BYTES : MAX_URL_BYTES;
+		if (value.length > oversized) {
+			return Promise.reject(new Error("The host service value exceeds its size limit."));
+		}
+		if (this.#pending.size >= MAX_PENDING) {
+			return Promise.reject(new Error("Too many pending host services."));
+		}
+		const serviceId = randomUUID();
+		const { promise, resolve, reject } = Promise.withResolvers<void>();
+		const timer = setTimeout(() => {
+			const pending = this.#pending.get(serviceId);
+			if (!pending) return;
+			this.#settle(serviceId, pending);
+			this.#notifyCancel(serviceId, pending);
+			reject(new Error("The browser host service timed out."));
+		}, this.#timeoutMs);
+		this.#pending.set(serviceId, { origin, kind, resolve, reject, timer });
+		try {
+			this.#channel.send({ serviceId, origin, kind, value });
+		} catch (error) {
+			const pending = this.#pending.get(serviceId);
+			if (pending) this.#settle(serviceId, pending);
+			reject(error instanceof Error ? error : new Error(String(error)));
+		}
+		return promise;
+	}
+}
+
+/**
+ * The native `/stats` helper reports one bare origin. Whether that host is
+ * actually assigned to the worker is proved by the worker's bind probe before
+ * it dials; the native side only rejects a shape that is not an origin.
+ */
+export function isStatsBridgeOrigin(url: string): boolean {
+	try {
+		const parsed = new URL(url);
+		return (
+			parsed.protocol === "http:" &&
+			parsed.pathname === "/" &&
+			parsed.search === "" &&
+			parsed.hash === "" &&
+			parsed.username === "" &&
+			parsed.password === "" &&
+			parsed.hostname.length > 0
+		);
+	} catch {
+		return false;
+	}
+}
+
+export function isHostServiceOrigin(value: unknown): value is HostServiceOrigin {
+	if (!value || typeof value !== "object") return false;
+	const origin = value as Partial<HostServiceOrigin>;
+	return (
+		typeof origin.requestId === "string" &&
+		origin.requestId.length > 0 &&
+		typeof origin.viewId === "string" &&
+		origin.viewId.length > 0 &&
+		typeof origin.transportId === "string" &&
+		origin.transportId.length > 0
+	);
+}
+
+export function isHostServiceReply(value: unknown): value is HostServiceReply {
+	if (!value || typeof value !== "object") return false;
+	const reply = value as Partial<HostServiceReply>;
+	return (
+		typeof reply.serviceId === "string" &&
+		reply.serviceId.length > 0 &&
+		isHostServiceOrigin(reply.origin) &&
+		typeof reply.accepted === "boolean" &&
+		(reply.error === undefined || typeof reply.error === "string")
+	);
+}
+
+function boundedError(error: string | undefined): string {
+	const message = error?.trim();
+	if (!message) return "The browser did not accept this host service.";
+	return message.length > MAX_ERROR_BYTES ? message.slice(0, MAX_ERROR_BYTES) : message;
+}
diff --git a/packages/coding-agent/test/modes/host-services.test.ts b/packages/coding-agent/test/modes/host-services.test.ts
new file mode 100644
index 0000000..0a1fe8b
--- /dev/null
+++ b/packages/coding-agent/test/modes/host-services.test.ts
@@ -0,0 +1,131 @@
+import { describe, expect, it } from "bun:test";
+import {
+	type HostServiceCancel,
+	RemoteHostServices,
+	type HostServiceOrigin,
+	type HostServiceRequest,
+} from "../../src/modes/host-services";
+
+const origin: HostServiceOrigin = { requestId: "event-1", viewId: "view-1", transportId: "transport-1" };
+
+function channel() {
+	const requests: HostServiceRequest[] = [];
+	const cancels: HostServiceCancel[] = [];
+	return {
+		requests,
+		cancels,
+		channel: {
+			send: (request: HostServiceRequest) => {
+				requests.push(request);
+			},
+			cancel: (request: HostServiceCancel) => {
+				cancels.push(request);
+			},
+		},
+	};
+}
+
+describe("RemoteHostServices", () => {
+	it("settles only the matching service request from its originating view and transport", async () => {
+		const harness = channel();
+		const services = new RemoteHostServices(harness.channel);
+		const result = services.run(origin, () => services.adapter.copyText("private clipboard payload"));
+		const request = harness.requests[0];
+		if (!request) throw new Error("host service request was not sent");
+		expect(request.origin).toEqual(origin);
+		expect(request.kind).toBe("copy_text");
+		expect(request.value).toBe("private clipboard payload");
+		expect(
+			services.reply({
+				serviceId: request.serviceId,
+				origin: { ...origin, viewId: "other-view" },
+				accepted: true,
+			}),
+		).toBe(false);
+		expect(
+			services.reply({
+				serviceId: request.serviceId,
+				origin: { ...origin, transportId: "stale-transport" },
+				accepted: true,
+			}),
+		).toBe(false);
+		let settled = false;
+		void result.then(() => {
+			settled = true;
+		});
+		await Promise.resolve();
+		expect(settled).toBe(false);
+		expect(services.reply({ serviceId: request.serviceId, origin, accepted: true })).toBe(true);
+		await result;
+		// A duplicate reply is consumed once and cannot settle a later request.
+		expect(services.reply({ serviceId: request.serviceId, origin, accepted: true })).toBe(false);
+		services.dispose();
+	});
+
+	it("rejects failed browser services and refuses effects outside a view action", async () => {
+		const harness = channel();
+		const services = new RemoteHostServices(harness.channel);
+		await expect(services.adapter.openUrl("https://example.com")).rejects.toThrow("view-owned user action");
+		const result = services.run(origin, () => services.adapter.openUrl("https://example.com"));
+		const request = harness.requests[0];
+		if (!request) throw new Error("host service request was not sent");
+		expect(request.kind).toBe("open_url");
+		expect(harness.requests.length).toBe(1);
+		expect(services.reply({ serviceId: request.serviceId, origin, accepted: false, error: "popup blocked" })).toBe(
+			true,
+		);
+		await expect(result).rejects.toThrow("popup blocked");
+		services.dispose();
+	});
+
+	it("withdraws every outstanding request when the hosted view is disposed", async () => {
+		const harness = channel();
+		const services = new RemoteHostServices(harness.channel);
+		const result = services.run(origin, () => services.adapter.copyText("text"));
+		services.dispose();
+		expect(harness.cancels).toHaveLength(1);
+		expect(harness.cancels[0]).toMatchObject({ origin, kind: "copy_text" });
+		expect(harness.cancels[0]).not.toHaveProperty("value");
+		await expect(result).rejects.toThrow("closed before the host service completed");
+	});
+
+	it("withdraws a request the browser never answered before its timeout", async () => {
+		const harness = channel();
+		const services = new RemoteHostServices(harness.channel, 5);
+		const result = services.run(origin, () => services.adapter.openUrl("https://example.com"));
+		await expect(result).rejects.toThrow("timed out");
+		expect(harness.cancels).toHaveLength(1);
+		expect(harness.cancels[0]).toMatchObject({ kind: "open_url", origin });
+		services.dispose();
+	});
+
+	it("bounds pending work and value sizes without sending anything", async () => {
+		const harness = channel();
+		const services = new RemoteHostServices(harness.channel);
+		const pending = Array.from({ length: 32 }, () => services.run(origin, () => services.adapter.copyText("x")));
+		expect(harness.requests).toHaveLength(32);
+		await expect(services.run(origin, () => services.adapter.copyText("x"))).rejects.toThrow("Too many pending");
+		expect(harness.requests).toHaveLength(32);
+		await expect(services.run(origin, () => services.adapter.copyText("x".repeat(1024 * 1024 + 1)))).rejects.toThrow(
+			"size limit",
+		);
+		expect(harness.requests).toHaveLength(32);
+		for (const request of harness.requests) {
+			services.reply({ serviceId: request.serviceId, origin, accepted: true });
+		}
+		await Promise.all(pending);
+		services.dispose();
+		expect(harness.cancels).toHaveLength(0);
+	});
+
+	it("rejects an oversized browser error without leaking it whole", async () => {
+		const harness = channel();
+		const services = new RemoteHostServices(harness.channel);
+		const result = services.run(origin, () => services.adapter.copyText("x"));
+		const request = harness.requests[0];
+		if (!request) throw new Error("host service request was not sent");
+		services.reply({ serviceId: request.serviceId, origin, accepted: false, error: "e".repeat(4096) });
+		await expect(result).rejects.toThrow(/^e{512}$/);
+		services.dispose();
+	});
+});
diff --git a/packages/tui/test/input-secret-ack.test.ts b/packages/tui/test/input-secret-ack.test.ts
new file mode 100644
index 0000000..973a7b1
--- /dev/null
+++ b/packages/tui/test/input-secret-ack.test.ts
@@ -0,0 +1,88 @@
+import { describe, expect, it } from "bun:test";
+import type { TspKind } from "@oh-my-pi/pi-wire";
+import { Editor } from "@oh-my-pi/pi-tui";
+import { Input } from "@oh-my-pi/pi-tui/components/input";
+import type { DescribeContext } from "@oh-my-pi/pi-tui/native/node";
+import { defaultEditorTheme } from "./test-themes";
+import { TspHarness } from "./native/tsp-harness";
+
+const cx: DescribeContext = {
+	cols: 80,
+	reduceMotion: false,
+	dark: true,
+	supports: (_kind: TspKind) => true,
+	feature: () => true,
+};
+
+describe("masked input edit acknowledgment", () => {
+	it("advertises the mask and never sends the secret as node text", () => {
+		const input = new Input();
+		input.mask = true;
+		input.setValue("correct horse");
+		const node = input.describe(cx);
+		expect(node.p).toMatchObject({ mask: true, text: "•".repeat(13), cursor: 13 });
+		expect(JSON.stringify(node.p)).not.toContain("correct");
+	});
+
+	it("acks a same-length secret replacement without a visible text change", () => {
+		const input = new Input();
+		input.mask = true;
+		input.setValue("abc");
+		input.applyHostEdit({ from: 0, to: 3, text: "xyz", cursor: 3, len: 3, n: 7 });
+		const node = input.describe(cx);
+		expect(input.getValue()).toBe("xyz");
+		expect(node.p).toMatchObject({ mask: true, text: "•••", ack: { n: 7, ok: true, cursor: 3 } });
+	});
+
+	it("releases a stale edit with ok:false and keeps the text", () => {
+		const input = new Input();
+		input.mask = true;
+		input.setValue("abc");
+		input.applyHostEdit({ from: 0, to: 3, text: "x", cursor: 1, len: 9, n: 8 });
+		const node = input.describe(cx);
+		expect(input.getValue()).toBe("abc");
+		expect(node.p).toMatchObject({ ack: { n: 8, ok: false } });
+	});
+
+	it("types a whole unicode secret and reports its grapheme caret", () => {
+		const input = new Input();
+		input.mask = true;
+		const secret = "pässwörd-e\u0301😀";
+		// Native single-line input normalizes NFC: the stored value is composed.
+		const stored = "pässwörd-é😀";
+		input.applyHostEdit({ from: 0, to: 0, text: secret, cursor: 11, len: 0, n: 10 });
