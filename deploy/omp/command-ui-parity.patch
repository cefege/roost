+import * as attestation from "../../src/live/attestation";
+import { CodexLiveTransport } from "../../src/live/transport";
+import { asGlobalFetch } from "../helpers/fetch-mock";
+
+afterEach(() => vi.restoreAllMocks());
+
+describe("live authentication before audio device ownership", () => {
+	for (const sdpOffer of [undefined, "v=0\r\nowned remote offer\r\n"]) {
+		it(`refuses missing OAuth before native audio, attestation or signaling (${sdpOffer ? "remote" : "terminal"})`, async () => {
+			const authStorage = new AuthStorage(new SqliteAuthCredentialStore(new Database(":memory:")));
+			await authStorage.credentials.reload();
+			const nativePeer = vi.spyOn(natives, "LiveWebRtcPeer");
+			// Protect the test host's physical devices even if the auth ordering regresses.
+			const guardedPeer = nativePeer as unknown as { mockImplementation(implementation: () => never): void };
+			guardedPeer.mockImplementation(function () { throw new Error("Physical audio is forbidden in this test"); });
+			const attest = vi.spyOn(attestation, "generateCodexAttestation").mockImplementation(async () => {
+				throw new Error("Attestation before authentication is forbidden in this test");
+			});
+			const fetch = vi.spyOn(globalThis, "fetch").mockImplementation(
+				asGlobalFetch(async () => {
+					throw new Error("External signaling is forbidden in this test");
+				}),
+			);
+			const transport = new CodexLiveTransport({
+				authStorage,
+				sessionId: "isolated-live-auth-test",
+				instructions: "Isolated live auth test",
+				voice: "vale",
+				sdpOffer,
+				callbacks: { onEvent: () => {}, onOutputLevel: () => {} },
+			});
+			try {
+				await expect(transport.connect()).rejects.toThrow("No Codex OAuth credential is available for a live call.");
+				expect(nativePeer).not.toHaveBeenCalled();
+				expect(attest).not.toHaveBeenCalled();
+				expect(fetch).not.toHaveBeenCalled();
+			} finally {
+				await transport.close();
+				authStorage.close();
+			}
+		});
+	}
+});
