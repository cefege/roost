+	readonly features?: readonly string[];
+	readonly transportId?: string;
+	/** The browser user's clock: `true` 12-hour, `false` 24-hour; the worker's locale is not theirs. */
+	readonly hour12?: boolean;
+}
+export interface RemoteCommandUiState {
+	readonly resumeId: string;
+	readonly cwd: string;
+	readonly streaming: boolean;
+	readonly restartRequested?: true;
+	readonly resetHistory?: true;
+	readonly stopReason?: string;
+	readonly error?: string;
+}
+
+/** A terminal adapter that lets the existing interactive controllers run without acquiring a tty. */
+class RemoteTerminal extends ProcessTerminal {
+	#cols: number;
+	#rows: number;
+	#appearance: TerminalAppearance;
+
+	constructor(open: RemoteCommandUiOpen) {
+		super();
+		this.#cols = open.cols;
+		this.#rows = open.rows;
+		this.#appearance = open.dark ? "dark" : "light";
+	}
+
+	override start(): void {}
+	override stop(): void {}
+	override write(): void {}
+	override drainInput(): Promise<void> {
+		return Promise.resolve();
+	}
+	override get columns(): number {
+		return this.#cols;
+	}
+	override get rows(): number {
+		return this.#rows;
+	}
+	override get appearance(): TerminalAppearance {
+		return this.#appearance;
+	}
+	override onAppearanceChange(): void {}
+
+	resize(cols: number, rows: number): void {
+		this.#cols = cols;
+		this.#rows = rows;
+	}
+
+	setAppearance(dark: boolean): void {
+		this.#appearance = dark ? "dark" : "light";
+	}
+}
+
+/** Owns one remote view over the ACP record's canonical AgentSession. */
+export class RemoteCommandUi {
+	readonly mode: InteractiveMode;
+	readonly #terminal: RemoteTerminal;
+	readonly #send: (message: NativeTransportMessage, transportId: string) => void;
+	readonly #onState: (state: RemoteCommandUiState) => void | Promise<void>;
+	#closeRequested = false;
+	#opened = false;
+	#disposed = false;
+	#nativeStarted = false;
+	#forceHistoryReset = true;
+	#transportId = "";
+	#presentation: RemoteCommandUiOpen | undefined;
+	#inputLoop: Promise<void> | undefined;
+	#opening: Promise<void> | undefined;
+	#commandPending = false;
+	#lastResumeId: string;
+	#lastStreaming: boolean;
+	#lastCwd: string;
+	#stateDelivery: Promise<void> | undefined;
+	readonly #hostServices: RemoteHostServices;
+	#unsubscribeRunState: () => void;
+	#unsubscribeSessionChange: () => void;
+
+	constructor(
+		session: AgentSession,
+		send: (message: NativeTransportMessage, transportId: string) => void,
+		onState: (state: RemoteCommandUiState) => void | Promise<void>,
+		initial: RemoteCommandUiOpen,
+		sendHostService: HostServiceChannel,
+		setToolUIContext?: (uiContext: ExtensionUIContext, hasUI: boolean) => void,
+	) {
+		this.#terminal = new RemoteTerminal(initial);
+		this.#send = send;
+		this.#onState = onState;
+		this.#hostServices = new RemoteHostServices(sendHostService);
+		this.#lastResumeId = session.sessionManager.getSessionId();
+		this.#lastCwd = session.sessionManager.getCwd();
+		this.#lastStreaming = session.isStreaming;
+		const composer = new Composer({
+			terminal: this.#terminal as Terminal,
+			tuiOptions: {
+				nativeSend: message => {
+					this.#send(message, this.#transportId);
+					// ACP has no shared terminal blob cache; transfer each blob inline.
+					if (
+						message.verb === "q" &&
+						typeof message.body === "object" &&
+						message.body !== null &&
+						"q" in message.body &&
+						message.body.q === "blobs"
+					) {
+						queueMicrotask(() => {
+							if (!this.#disposed) this.mode.ui.handleRemoteInput(encodeTspJson("r", { r: "blobs", have: [] }));
+						});
+					}
+				},
+			},
+			preferences: { quiet: true },
+			exit: () => {},
+		});
+		this.mode = new InteractiveMode(
+			session,
+			VERSION,
+			undefined,
+			setToolUIContext,
+			undefined,
+			undefined,
+			undefined,
+			composer,
+			undefined,
+			undefined,
+			true,
+			() => void this.close(),
+			async () => this.publishState(true),
+			this.#hostServices.adapter,
+		);
+		this.#unsubscribeRunState = session.subscribeRunState(() => {
+			void this.publishState().catch(() => {});
+		});
+		this.#unsubscribeSessionChange = session.registerSessionChangeCallback(() => {
+			void this.publishState().catch(() => {});
+		});
+	}
+
+	get transportId(): string {
+		return this.#transportId;
+	}
+
+	async open(options: RemoteCommandUiOpen, origin?: HostServiceOrigin): Promise<void> {
+		if (this.#disposed) throw new Error("Remote command UI is disposed");
+		if (this.#opening) {
+			await this.#opening;
+			return this.open(options, origin);
+		}
+		this.#closeRequested = false;
+		const refresh = this.#opened && options.transportId !== undefined && options.transportId === this.#transportId;
+		if (!refresh) this.#forceHistoryReset = true;
+		const apply = () => (refresh ? this.#refresh(options) : this.#initialize(options));
+		const opening = origin ? this.#hostServices.run(origin, apply) : apply();
+		this.#opening = opening;
+		try {
+			await opening;
+		} finally {
+			if (this.#opening === opening) this.#opening = undefined;
+		}
+	}
+
+	async #initialize(options: RemoteCommandUiOpen): Promise<void> {
+		this.#terminal.resize(options.cols, options.rows);
+		this.#terminal.setAppearance(options.dark);
+		if (!this.mode.isInitialized) {
+			await this.mode.init({ suppressWelcomeIntro: true });
+			await this.mode.renderInitialMessages({ preserveExistingChat: true });
+		}
+		if (this.#disposed || this.#closeRequested) return;
+		const hello = this.#hello(options);
+		this.#transportId = options.transportId ?? crypto.randomUUID();
+		if (this.#nativeStarted) this.mode.ui.resetNative(hello);
+		else this.mode.ui.startNative(hello);
+		this.#nativeStarted = true;
+		this.#opened = true;
+		this.#presentation = options;
+		if (!this.#inputLoop) this.#inputLoop = this.#runInputLoop();
+		await this.publishState();
+	}
+
+	#hello(options: RemoteCommandUiOpen): TspHello {
+		return {
+			r: "hello",
+			v: TSP_VERSION,
+			term: "acp",
+			kinds: options.kinds ?? TSP_KINDS,
+			features: options.features ?? [],
+			cols: options.cols,
+			dark: options.dark,
+			reduceMotion: options.reduceMotion,
+			...(options.hour12 === undefined ? {} : { hour12: options.hour12 }),
+		};
+	}
+
+	async #refresh(options: RemoteCommandUiOpen): Promise<void> {
+		const previous = this.#presentation!;
+		const changedSet = (left: readonly string[], right: readonly string[]) =>
+			left.length !== right.length || left.some(value => !right.includes(value));
+		const vocabularyChanged =
+			changedSet(previous.kinds ?? TSP_KINDS, options.kinds ?? TSP_KINDS) ||
+			changedSet(previous.features ?? [], options.features ?? []) ||
+			previous.hour12 !== options.hour12;
+		const geometryChanged = options.cols !== this.#terminal.columns || options.rows !== this.#terminal.rows;
+		const themeChanged = options.dark !== (this.#terminal.appearance === "dark");
+		const motionChanged = options.reduceMotion !== previous.reduceMotion;
+		this.#presentation = options;
+		if (!vocabularyChanged && !geometryChanged && !themeChanged && !motionChanged) return;
+		this.#terminal.resize(options.cols, options.rows);
+		this.#terminal.setAppearance(options.dark);
+		if (vocabularyChanged) this.mode.ui.renegotiateNative(this.#hello(options));
+		if (geometryChanged) this.mode.ui.dispatchNativeEvent({ ev: "resize", cols: options.cols, rows: options.rows });
+		if (themeChanged) this.mode.ui.dispatchNativeEvent({ ev: "theme", dark: options.dark });
+		if (motionChanged) this.mode.ui.dispatchNativeEvent({ ev: "motion", reduce: options.reduceMotion });
+		this.mode.ui.flushNativeFrames();
+	}
+
+	event(event: TspEvent, origin?: HostServiceOrigin): void {
+		if (!this.#opened || this.#disposed) return;
+		const dispatch = () => {
+			if (event.ev === "resize") {
+				if (this.#presentation)
+					this.#presentation = {
+						...this.#presentation,
+						cols: event.cols,
+						rows: event.rows ?? this.#terminal.rows,
+					};
+				this.#terminal.resize(event.cols, event.rows ?? this.#terminal.rows);
+				this.mode.ui.dispatchNativeEvent(event);
+				this.mode.ui.flushNativeFrames();
+				return;
+			}
+			if (event.ev === "theme") this.#terminal.setAppearance(event.dark);
+			if (this.#presentation && event.ev === "theme")
+				this.#presentation = { ...this.#presentation, dark: event.dark };
+			if (this.#presentation && event.ev === "motion")
+				this.#presentation = { ...this.#presentation, reduceMotion: event.reduce };
+			this.mode.ui.dispatchNativeEvent(event);
+			this.mode.ui.flushNativeFrames();
+		};
+		if (origin) this.#hostServices.run(origin, dispatch);
+		else dispatch();
+	}
+
+	/**
+	 * Apply one key sequence. A browser-side caret edit rides along as `before`
+	 * and must land first, in the same origin, so the two RPCs cannot reorder.
+	 */
+	input(data: string, origin?: HostServiceOrigin, before?: TspEvent): void {
+		if (!this.#opened || this.#disposed) return;
+		const dispatch = () => {
+			if (before) this.mode.ui.dispatchNativeEvent(before);
+			this.mode.ui.handleRemoteInput(data);
+			this.mode.ui.flushNativeFrames();
+		};
+		if (origin) this.#hostServices.run(origin, dispatch);
+		else dispatch();
+	}
+
+	async command(text: string, origin?: HostServiceOrigin): Promise<boolean> {
+		if (!this.#opened || this.#disposed) return false;
+		if (this.#commandPending) throw new Error("A remote command is already being submitted");
+		this.#commandPending = true;
+		try {
+			const dispatch = async () => {
+				this.mode.editor.setText(text);
+				this.mode.ui.handleRemoteInput("\r");
+				this.mode.ui.flushNativeFrames();
+				await this.mode.waitForSubmissionDispatches();
+				await this.publishState();
+			};
+			if (origin) await this.#hostServices.run(origin, dispatch);
+			else await dispatch();
+			return true;
+		} finally {
+			this.#commandPending = false;
+		}
+	}
+	hostServiceReply(reply: HostServiceReply): boolean {
+		return this.#hostServices.reply(reply);
+	}
+
+	async publishState(restartRequested = false): Promise<void> {
+		if (this.#disposed || !this.#nativeStarted) return;
+		const resumeId = this.mode.sessionManager.getSessionId();
+		const cwd = this.mode.sessionManager.getCwd();
+		const resetHistory = this.#forceHistoryReset || resumeId !== this.#lastResumeId || cwd !== this.#lastCwd;
+		this.#forceHistoryReset = false;
+		this.#lastResumeId = resumeId;
+		this.#lastCwd = cwd;
+		const streaming = this.mode.session.isStreaming;
+		const ended = this.#lastStreaming && !streaming;
+		this.#lastStreaming = streaming;
+		const lastAssistant = ended
+			? this.mode.session.agent.state.messages.findLast(message => message.role === "assistant")
+			: undefined;
+		const state: RemoteCommandUiState = {
+			resumeId,
+			cwd,
+			streaming,
+			...(resetHistory ? { resetHistory: true } : {}),
+			...(lastAssistant?.stopReason ? { stopReason: lastAssistant.stopReason } : {}),
+			...(lastAssistant?.stopReason === "error" && lastAssistant.errorMessage
+				? { error: lastAssistant.errorMessage }
+				: {}),
+			...(restartRequested ? { restartRequested: true as const } : {}),
+		};
+		const delivery = this.#stateDelivery
+			? this.#stateDelivery.then(() => this.#onState(state))
+			: Promise.resolve(this.#onState(state));
+		this.#stateDelivery = delivery;
+		try {
+			await delivery;
+		} catch (error) {
+			if (resetHistory) this.#forceHistoryReset = true;
+			throw error;
+		} finally {
+			if (this.#stateDelivery === delivery) this.#stateDelivery = undefined;
+		}
+	}
+
+	async close(): Promise<void> {
+		if (this.#disposed) return;
+		this.#closeRequested = true;
+		await this.#opening?.catch(() => {});
+		if (!this.#opened) return;
+		this.#opened = false;
+		await this.mode.stopRemoteLive();
+		this.#hostServices.cancelPending("The OMP view closed before the host service completed.");
+		this.mode.ui.closeNative();
+	}
+
+	async dispose(): Promise<void> {
+		if (this.#disposed) return;
+		await this.close();
+		this.#disposed = true;
+		this.#hostServices.dispose();
+		this.#unsubscribeRunState();
+		this.#unsubscribeSessionChange();
+		this.mode.stop();
+		await this.mode.ui.stop();
+	}
+
+	async #runInputLoop(): Promise<void> {
+		while (!this.#disposed) {
+			try {
+				const input = await this.mode.getUserInput();
+				await submitInteractiveInput(this.mode, this.mode.session, input);
+				await this.publishState();
+			} catch (error) {
+				if (this.#disposed) return;
+				this.mode.showError(error instanceof Error ? error.message : String(error));
+			}
+		}
+	}
+}
