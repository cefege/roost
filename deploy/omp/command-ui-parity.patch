diff --git a/packages/tui/src/components/composer/native-chrome.ts b/packages/tui/src/components/composer/native-chrome.ts
new file mode 100644
index 0000000000..4f28ec2634
--- /dev/null
+++ b/packages/tui/src/components/composer/native-chrome.ts
@@ -0,0 +1,85 @@
+/**
+ * Projects registered composer drawing around a native editable slot.
+ * The same render functions own glyphs, status placement and styled surfaces;
+ * text remains in the host's one native control, never a rendered-row fallback.
+ */
+import type { TspEditorChrome, TspEditorChromeRow, TspSpan } from "@oh-my-pi/pi-wire";
+import { compactText, styledSpans } from "../../native/spans";
+import { visibleWidth } from "../../utils";
+import type { ComposerChromeContext, ComposerStyle } from "./types";
+
+const SLOT = "\uE000";
+
+function noninteractive(spans: readonly TspSpan[]): TspSpan[] {
+	return spans.map(span => {
+		const copy = { ...span };
+		delete copy.href;
+		return copy;
+	});
+}
+
+function row(style: ComposerStyle, ctx: ComposerChromeContext, gutter: string, last: boolean): TspEditorChromeRow {
+	const columns = Math.max(1, ctx.width - style.sideChromeWidth(ctx.paddingX) * 2 - visibleWidth(gutter));
+	const rendered = style.renderRow({
+		...ctx,
+		text: SLOT.repeat(columns),
+		pad: "",
+		gutter,
+		isLastRow: last,
+		cursorOverflow: 0,
+		imeSafeCursorTail: false,
+		scrollbarThumb: false,
+	});
+	if (rendered.length !== 1) throw new Error("content rows must contain one native editable slot");
+	const spans = noninteractive(styledSpans(rendered[0]!, { background: true }));
+	const plain = spans.map(span => span.t).join("");
+	const start = plain.indexOf(SLOT);
+	if (start < 0 || plain.slice(start, start + columns) !== SLOT.repeat(columns) || plain.indexOf(SLOT, start + columns) !== -1) {
+		throw new Error("the style must preserve the native editable cells");
+	}
+	const prefix: TspSpan[] = [];
+	const suffix: TspSpan[] = [];
+	let offset = 0;
+	let inputStyle: string | undefined;
+	let sampled = false;
+	for (const span of spans) {
+		const end = offset + span.t.length;
+		if (offset < start) prefix.push({ ...span, t: span.t.slice(0, start - offset) });
+		if (end > start + columns) suffix.push({ ...span, t: span.t.slice(Math.max(0, start + columns - offset)) });
+		if (end > start && offset < start + columns) {
+			if (span.fx || (sampled && inputStyle !== span.s)) throw new Error("editable cell styling must be uniform");
+			inputStyle = span.s;
+			sampled = true;
+		}
+		offset = end;
+	}
+	return { prefix: compactText(prefix), suffix: compactText(suffix), ...(inputStyle ? { s: inputStyle } : {}) };
+}
+
+export function describeComposerChrome(
+	style: ComposerStyle,
+	ctx: ComposerChromeContext,
+	gutter?: { firstLine: string; continuation: string },
+): TspEditorChrome {
+	try {
+		const top = style.renderTop(ctx);
+		const bottom = style.renderBottom(ctx);
+		const only = row(style, ctx, gutter?.firstLine ?? "", true);
+		const first = row(style, ctx, gutter?.firstLine ?? "", false);
+		const middle = row(style, ctx, gutter?.continuation ?? "", false);
+		const last = row(style, ctx, gutter?.continuation ?? "", true);
+		if ([first, middle, last].some(candidate => candidate.s !== only.s)) {
+			throw new Error("editable-cell styling must be uniform across native rows");
+		}
+		return {
+			top: top === undefined ? [] : [compactText(noninteractive(styledSpans(top, { background: true })))],
+			only,
+			first,
+			middle,
+			last,
+			bottom: bottom === undefined ? [] : [compactText(noninteractive(styledSpans(bottom, { background: true })))],
+		};
+	} catch (error) {
+		return { error: `Composer style "${style.id}" cannot frame a native editor: ${error instanceof Error ? error.message : String(error)}` };
+	}
+}
