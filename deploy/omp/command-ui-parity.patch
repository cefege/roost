diff --git a/packages/coding-agent/test/modes/controllers/hosted-live-audio.test.ts b/packages/coding-agent/test/modes/controllers/hosted-live-audio.test.ts
new file mode 100644
index 0000000000..9f594f2525
--- /dev/null
+++ b/packages/coding-agent/test/modes/controllers/hosted-live-audio.test.ts
@@ -0,0 +1,91 @@
+import { describe, expect, it } from "bun:test";
+import type { ExtensionLiveStartOptions } from "../../../src/extensibility/extensions/types";
+import { HostedLiveAudio } from "../../../src/modes/controllers/hosted-live-audio";
+import type { InteractiveLiveAudio } from "../../../src/modes/types";
+
+describe("HostedLiveAudio ownership", () => {
+	it("uses caller SDP, serializes mute, and rejects errors from a retired peer", async () => {
+		const effects: string[] = [];
+		const failures: Error[] = [];
+		let peerId = "";
+		let options: ExtensionLiveStartOptions | undefined;
+		const muted = Promise.withResolvers<void>();
+		const audio: InteractiveLiveAudio = {
+			prepare: async id => { peerId = id; effects.push("prepare"); return "real caller offer"; },
+			connect: async (id, answer) => { expect(id).toBe(peerId); expect(answer).toBe("canonical answer"); effects.push("connect"); },
+			mute: async (id, value) => { expect(id).toBe(peerId); effects.push(`mute:${value}`); muted.resolve(); },
+			close: async id => { expect(id).toBe(peerId); effects.push("close"); },
+		};
+		const owner = new HostedLiveAudio(audio, {
+			start: async input => {
+				options = input;
+				expect(input.sdpOffer).toBe("real caller offer");
+				effects.push("canonical-start");
+				return { sdpAnswer: "canonical answer", voice: "vale", stop: async () => input.onEnd?.() };
+			},
+			reportFailure: error => { failures.push(error); options?.onEnd?.(error); return true; },
+			showError: message => { throw new Error(`Unexpected adapter error: ${message}`); },
+		});
+		await owner.start();
+		expect(effects).toEqual(["prepare", "canonical-start", "connect"]);
+		options?.onPhase?.("muted");
+		await muted.promise;
+		expect(effects.at(-1)).toBe("mute:true");
+		options?.onPhase?.("error");
+		owner.reportMediaError(JSON.stringify({ peerId: "retired-peer", error: "stale failure" }));
+		expect(failures).toEqual([]);
+		owner.reportMediaError(JSON.stringify({ peerId, error: "Microphone permission denied" }));
+		expect(failures.map(error => error.message)).toEqual(["Microphone permission denied"]);
+		expect(owner.active).toBe(false);
+		expect(effects.at(-1)).toBe("close");
+		expect(effects).not.toContain("mute:false");
+	});
+
+	it("never starts the canonical call from a late SDP after Stop", async () => {
+		const offer = Promise.withResolvers<string>();
+		const effects: string[] = [];
+		let signal: AbortSignal | undefined;
+		const owner = new HostedLiveAudio({
+			prepare: async (_id, abort) => { signal = abort; return await offer.promise; },
+			connect: async () => { effects.push("connect"); },
+			mute: async () => {},
+			close: async () => { effects.push("close"); },
+		}, {
+			start: async () => { effects.push("canonical-start"); throw new Error("Retired offer started"); },
+			reportFailure: () => false,
+			showError: message => { throw new Error(message); },
+		});
+		const starting = owner.start();
+		owner.stop();
+		expect(signal?.aborted).toBe(true);
+		offer.resolve("late actual SDP");
+		await starting;
+		expect(effects).toEqual(["close"]);
+		expect(owner.active).toBe(false);
+	});
+
+	it("aborts a pending browser permission request and ignores its late completion", async () => {
+		const connecting = Promise.withResolvers<void>();
+		const connected = Promise.withResolvers<void>();
+		let signal: AbortSignal | undefined;
+		let closes = 0;
+		const owner = new HostedLiveAudio({
+			prepare: async () => "caller offer",
+			connect: async (_id, _answer, abort) => { signal = abort; connecting.resolve(); await connected.promise; },
+			mute: async () => {},
+			close: async () => { closes++; },
+		}, {
+			start: async () => ({ sdpAnswer: "canonical answer", voice: "vale", stop: async () => {} }),
+			reportFailure: () => { throw new Error("Late permission affected a retired call"); },
+			showError: message => { throw new Error(message); },
+		});
+		const starting = owner.start();
+		await connecting.promise;
+		owner.stop();
+		expect(signal?.aborted).toBe(true);
+		connected.resolve();
+		await starting;
+		expect(closes).toBe(1);
+		expect(owner.active).toBe(false);
+	});
+});
