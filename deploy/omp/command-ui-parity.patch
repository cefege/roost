+import { beforeAll, describe, expect, it } from "bun:test";
+import type { TspEditorChrome, TspEditorProps, TspText } from "@oh-my-pi/pi-wire";
+import { Editor } from "../../src/components/editor";
+import { BUILTIN_EDITOR_BORDER_STYLES, type ComposerStyle } from "../../src/components/composer/types";
+import type { DescribeContext, NativeNode } from "../../src/native/node";
+import { plainText, styledSpans } from "../../src/native/spans";
+import { ComposerShapePreview, renderComposerShapePreview } from "../../src/overlays/composer-shape-preview";
+import { installExtensionComposerShape } from "../../src/overlays/composer-shape-registry";
+import { getEditorTheme, initTheme, theme } from "../../src/theme/theme";
+import { visibleWidth } from "../../src/utils";
+
+const cx: DescribeContext = { cols: 64, dark: true, reduceMotion: false, supports: () => true, feature: () => true };
+
+beforeAll(async () => {
+	await initTheme();
+});
+
+function text(value: TspText | undefined): string {
+	return typeof value === "string" ? value : (value?.map(span => span.t).join("") ?? "");
+}
+
+function input(editor: Editor): TspEditorProps {
+	const child = editor.describe(cx).c?.find(child => "k" in child && child.k === "editor");
+	if (!child || !("k" in child) || child.k !== "editor") throw new Error("missing actual editor descriptor");
+	return child.p ?? {};
+}
+
+function materialize(chrome: TspEditorChrome, lines: readonly string[]): string[] {
+	if ("error" in chrome) throw new Error(chrome.error);
+	return [
+		...chrome.top.map(text),
+		...lines.map((line, index) => {
+			const row =
+				lines.length === 1
+					? chrome.only
+					: index === 0
+						? chrome.first
+						: index === lines.length - 1
+							? chrome.last
+							: chrome.middle;
+			const prefix = text(row.prefix);
+			const suffix = text(row.suffix);
+			return (
+				prefix +
+				line +
+				" ".repeat(Math.max(0, cx.cols - visibleWidth(prefix + line + suffix))) +
+				suffix
+			).trimEnd();
+		}),
+		...chrome.bottom.map(text),
+	];
+}
+
+function drawing(root: NativeNode): string {
+	const child = root.c?.find(
+		child => "k" in child && child.k === "text" && child.p?.role === "omp.preview.composer-shape.drawing",
+	);
+	if (!child || !("k" in child) || child.k !== "text") throw new Error("missing production preview drawing");
+	return text(child.p?.spans ?? child.p?.text);
+}
+
+/** The terminal's frame with its software caret cell blank (native hosts draw their own caret) and no trailing blank cells. */
+function terminalFrame(editor: Editor): string[] {
+	const caret = getEditorTheme().symbols.inputCursor;
+	return editor.render(cx.cols).map(line => plainText(line).replace(caret, " ").trimEnd());
+}
+
+describe("actual native composer chrome", () => {
+	for (const shape of BUILTIN_EDITOR_BORDER_STYLES) {
+		it(`${shape} preserves the production frame around single and multiline editing`, () => {
+			const editor = new Editor(getEditorTheme());
+			editor.setBorderStyle(shape);
+			editor.setTopBorder({ content: "session status", width: 14 });
+			for (const lines of [["sample"], ["first", "middle", "last"]]) {
+				editor.setText(lines.join("\n"));
+				const canonical = terminalFrame(editor);
+				const props = input(editor);
+				expect(props.text).toBe(lines.join("\n"));
+				expect(props.chrome).toBeDefined();
+				expect(materialize(props.chrome!, lines)).toEqual(canonical);
+			}
+		});
+	}
+
+	it("uses registered extension drawing without replacing the native editor", () => {
+		const style: ComposerStyle = {
+			id: "native-chrome-test-extension",
+			sideBorders: false,
+			verticalChrome: 1,
+			statusAttachment: "none",
+			bottomBar: "none",
+			bottomBarGap: false,
+			defaultPromptGutter: "EXT ",
+			defaultPaddingX: () => 0,
+			sideChromeWidth: () => 0,
+			renderTop: context => context.accentColor("=".repeat(context.width)),
+			renderRow: context => [context.gutter + context.text + context.pad],
+			renderBottom: () => undefined,
+		};
+		const dispose = installExtensionComposerShape({
+			label: "Native extension",
+			description: "Registered drawing",
+			style,
+		});
+		try {
+			const editor = new Editor(getEditorTheme());
+			editor.setText("unchanged draft");
+			editor.setBorderStyle(style.id);
+			expect(materialize(input(editor).chrome!, ["unchanged draft"])).toEqual(terminalFrame(editor));
+			editor.setBorderStyle("rail");
+			expect(input(editor).text).toBe("unchanged draft");
+			expect(materialize(input(editor).chrome!, ["unchanged draft"])).toEqual(terminalFrame(editor));
+		} finally {
+			dispose();
+		}
+	});
+
+	it("keeps real field fill tokens for ordinary and editable-cell spans", () => {
+		const styled = theme.bgFill("userMessageBg", "sample");
+		expect(styledSpans(styled).some(span => span.s?.includes("bg:userMessageBg"))).toBe(true);
+		expect(styledSpans(styled, { background: false }).some(span => span.s?.includes("bg:"))).toBe(false);
+		const editor = new Editor(getEditorTheme());
+		editor.setBorderStyle("field");
+		const chrome = input(editor).chrome!;
+		if ("error" in chrome) throw new Error(chrome.error);
+		expect(chrome.only.s).toContain("bg:userMessageBg");
+	});
+
+	it("reports an incompatible extension row instead of dropping its drawing", () => {
+		const style: ComposerStyle = {
+			id: "native-chrome-test-incompatible",
+			sideBorders: false,
+			verticalChrome: 0,
+			statusAttachment: "none",
+			bottomBar: "none",
+			bottomBarGap: false,
+			defaultPromptGutter: undefined,
+			defaultPaddingX: () => 0,
+			sideChromeWidth: () => 0,
+			renderTop: () => undefined,
+			renderRow: context => ["extra row", context.text],
+			renderBottom: () => undefined,
+		};
+		const dispose = installExtensionComposerShape({
+			label: "Incompatible",
+			description: "Extra physical content rows",
+			style,
+		});
+		try {
+			const editor = new Editor(getEditorTheme());
+			editor.setBorderStyle(style.id);
+			editor.setText("retained");
+			expect(input(editor).chrome).toMatchObject({ error: expect.stringContaining("one native editable slot") });
+			expect(input(editor).text).toBe("retained");
+		} finally {
+			dispose();
+		}
+	});
+
+	it("describes actual preview drawing and updates it on width and status changes", () => {
+		let statusText = "initial";
+		const status = {
+			getTopBorder: () => ({ content: statusText, width: statusText.length }),
+			getBandTopBorder: () => ({ content: statusText, width: statusText.length }),
+			getStandaloneTopBorder: () => ({ content: statusText, width: statusText.length }),
+			renderBottomBar: () => statusText,
+		};
+		const preview = new ComposerShapePreview("box", { status });
+		expect(drawing(preview.describe(cx))).toBe(
+			renderComposerShapePreview("box", cx.cols, status).map(plainText).join("\n"),
+		);
+		statusText = "changed status";
+		expect(drawing(preview.describe(cx))).toContain(statusText);
+		const narrow = { ...cx, cols: 40 };
+		expect(drawing(preview.describe(narrow))).toBe(
+			renderComposerShapePreview("box", narrow.cols, status).map(plainText).join("\n"),
+		);
+	});
+});
