{
  "name": "roost",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "version": "0.4.2",
  "description": "Roost v2 monorepo — Bun + TS + Solid. An AI engineer's daily driver: real infrastructure for running a fleet of coding agents, not a demo.",
  "workspaces": [
    "apps/*",
    "smoke"
  ],
  "scripts": {
    "smoke": "bun test smoke/bun_smoke.test.ts",
    "typecheck": "bun run --filter='./apps/*' typecheck",
    "lint": "bun scripts/lint-roost.ts",
    "knip": "knip",
    "test": "bun apps/roost-cli/src/main.ts test all",
    "test:unit": "bun apps/roost-cli/src/main.ts test unit",
    "test:worker": "bun scripts/test-worker.ts",
    "test:terminal": "bun apps/roost-cli/src/main.ts test terminal",
    "test:live-api": "bun apps/roost-cli/src/main.ts test live-api",
    "dev": "bun run --filter='*' dev",
    "roost": "bun apps/roost-cli/src/main.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "latest",
    "@types/node": "22",
    "@typescript/native-preview": "^7.0.0-dev.20260621.1",
    "knip": "^6.26.0",
    "solid-js": "^1.9.4"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
