{
  "name": "roost",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "version": "0.2.0",
  "description": "Roost v2 monorepo — Bun + TS + Solid. Personal-fleet terminal multiplexer.",
  "workspaces": [
    "apps/*",
    "smoke"
  ],
  "scripts": {
    "smoke": "bun test smoke/",
    "typecheck": "bun run --filter='./apps/*' typecheck",
    "knip": "knip",
    "test": "bun test apps smoke",
    "dev": "bun run --filter='*' dev",
    "roost": "bun run --cwd apps/roost-cli dev"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "latest",
    "@types/node": "22",
    "@typescript/native-preview": "^7.0.0-dev.20260621.1",
    "knip": "^6.26.0"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
