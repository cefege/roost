---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  maxWidth?: number;
  /** Hero use only: opt out of lazy loading for the LCP image. */
  eager?: boolean;
  /** Override the responsive hint when the frame is narrower than `maxWidth`. */
  sizes?: string;
}

const { src, alt, caption, maxWidth = 1040, eager = false, sizes }: Props = Astro.props;

// Never hand sharp an upscale: sidebar-status.png is only 600px wide, so asking
// for 1440 would blow up the byte count for a blurrier image.
const CANDIDATE_WIDTHS = [640, 1024, 1440];
const fitted = CANDIDATE_WIDTHS.filter((w) => w <= src.width);
const widths = fitted.length > 0 ? fitted : [src.width];
const sizesAttr = sizes ?? `(max-width: ${maxWidth}px) 100vw, ${maxWidth}px`;
---

<figure class="shot" style={`--shot-max: ${maxWidth}px`}>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizesAttr}
    loading={eager ? "eager" : "lazy"}
    decoding={eager ? "auto" : "async"}
    fetchpriority={eager ? "high" : undefined}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot {
    margin: 0;
    max-width: var(--shot-max, 1040px);
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--border-strong);
    border-radius: var(--md-shape-md);
    background: var(--surface-0);
  }

  figcaption {
    margin-top: var(--md-space-2);
    color: var(--text-lo);
    font-size: var(--md-label-m-size);
    line-height: var(--md-label-m-line);
    font-weight: var(--md-label-m-weight);
  }
</style>
