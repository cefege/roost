---
/**
 * The Roost glyph. Geometry is inlined verbatim from apps/web/public/icon.svg
 * (24x24 viewBox, coral #db7556 on a #0d0d0d rounded tile) so the site mark and
 * the app icon can never drift into two different birds.
 *
 * Decorative by default: every call site pairs it with the "Roost" wordmark, so
 * announcing it again would just duplicate the label.
 */
interface Props {
  size?: number;
}

const { size = 28 }: Props = Astro.props;
---

<svg
  class="brandmark"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <rect width="24" height="24" rx="5" fill="#0d0d0d"></rect>
  <g fill="#db7556">
    <ellipse cx="11.5" cy="12.5" rx="6.2" ry="6.4"></ellipse>
    <circle cx="14.5" cy="8" r="3.6"></circle>
    <polygon points="17.5,6.4 19.9,8.8 17.5,11.2"></polygon>
    <polygon points="8.5,10.5 4.0,18.6 11.0,19.0"></polygon>
    <rect x="4.8" y="19" width="14.4" height="1.5" rx="0.75"></rect>
  </g>
</svg>

<style>
  .brandmark {
    display: block;
    flex: none;
    border-radius: var(--md-shape-sm);
  }
</style>
