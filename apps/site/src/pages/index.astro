---
/**
 * Public landing page metadata, hero, deployment details, install CTAs, and FAQ.
 * The long capability tour lives in HomeFeatureTour to keep this page navigable.
 * Shared landing components and canonical media own the visual presentation.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import FeatureRow from "../components/FeatureRow.astro";
import HomeFeatureTour from "../components/HomeFeatureTour.astro";
import Screenshot from "../components/Screenshot.astro";
import CtaBand from "../components/CtaBand.astro";
import Callout from "../components/Callout.astro";
import { SHOTS } from "../data/media";
import { FAQ } from "../data/faq";
import { clampDescription } from "../lib/seo";

const TITLE = "Roost — one self-hosted dashboard for your machines";
const DESCRIPTION = clampDescription(
  "Run any CLI across your macOS and Linux machines from one self-hosted browser dashboard. Roost v0.5.0 supports automatic Tailscale Serve or direct HTTPS.",
);

// JSON-LD needs absolute URLs. `site` is set unconditionally in
// astro.config.mjs; BaseLayout throws on the same condition.
const site = Astro.site;
if (!site) throw new Error("index.astro: astro.config.mjs must set `site`");

const REPO = "https://github.com/cefege/roost";

/** Published installer followed by the default automatic-mode quickstart. */
const POSIX = `curl -fsSL https://raw.githubusercontent.com/cefege/roost/main/install-binary.sh | bash
"$HOME/.local/bin/roost" quickstart`;

const HOMEBREW = `brew install cefege/tap/roost`;

/** Compact public view of the coordinator-to-worker transport. */
const DIAGRAM = `   Browser  (any device with a modern browser)
      │   Connect-RPC over HTTP/2, protobuf binary
      │   terminal data · session state, one connection
      ▼
 ┌─────────────────────────┐
 │ Coordinator  (Bun)      │   event-sourced SQLite · auth · session registry
 │ one HTTPS endpoint      │   fans live updates out to every open browser
 └───────────┬─────────────┘
             │   raw WebSocket · protobuf frames · workers dial outbound
      ┌──────┴──────────┐
      ▼                 ▼
   Worker             Worker        (Bun, one per machine)
   macOS              Linux
      │  a keeper subprocess hosts every PTY and outlives worker restarts`;

const softwareApplication = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Roost",
  description: DESCRIPTION,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Linux",
  url: new URL("/", site).href,
  codeRepository: REPO,
  license: "GPL-3.0-only",
};

const faqPage = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BaseLayout title={TITLE} description={DESCRIPTION}>
  {/* 1 — Hero */}
  <Hero
    title="Your machines. One self-hosted dashboard."
    sub="Run Claude Code, Codex, OMP, or any other CLI across your macOS and Linux machines. Roost v0.5.0 is released for accountless self-hosting, with automatic Tailscale Serve or direct HTTPS."
    badges={["v0.5.0", "self-hosted", "macOS + Linux"]}
  >
    <a class="btn btn-primary" href="/install/">Install Roost</a>
    <a class="btn" href="/docs/quickstart/">Quickstart</a>
    <a class="btn" href="https://github.com/cefege/roost/releases">Release assets</a>
  </Hero>

  <div class="wrap shot-hero">
    <Screenshot
      src={SHOTS.hero.src}
      alt={SHOTS.hero.alt}
      caption="One tab: every machine's live sessions on the left, a real PTY filling the workspace."
      eager
    />
  </div>

  <div class="wrap">
    {/* 2 — The problem */}
    <div class="section">
      <FeatureRow eyebrow="The problem" title="The machines are idle and the sessions are unreachable">
        <p>
          There is a MacBook in a drawer, a Mac mini under the desk, and a Linux
          box in the corner. All of that capacity sits idle while one laptop does
          the work.
        </p>
        <p>
          Meanwhile &ldquo;remote&rdquo; means opening a terminal, SSH-ing in, and hunting for
          the session you left running — assuming it survived the disconnect. From a
          phone it means nothing at all.
        </p>
        <p>
          And an agent CLI is a single-session tool: one window, one machine, one
          thing at a time, with no way to see which of the five you started is
          waiting on an answer.
        </p>
      </FeatureRow>
    </div>

    <HomeFeatureTour />

    {/* 11 — Deployment */}
    <div class="section">
      <FeatureRow
        eyebrow="Deployment"
        title="Self-hosted and released"
        media={SHOTS.pairQr.src}
        alt={SHOTS.pairQr.alt}
        caption="Each browser keeps its own non-extractable device key."
        reverse
      >
        <p>
          <strong>Roost v0.5.0 is released for accountless self-hosting.</strong> You
          operate the coordinator on macOS or Linux and authorize browsers through QR,
          a one-shot bootstrap token, loopback registration, or approval from a device
          you already trust.
        </p>
        <p>
          <strong>The managed deployment is qualified, not publicly launched.</strong>
          Production publishes no managed coordinator image and the shared dashboard
          origin is inactive. Email signup and Google authentication are off; managed
          accounts exist only when an operator creates them.
        </p>
        <p>
          Each self-hosted browser mints an Ed25519 key pair with WebCrypto. The private
          key is non-extractable and persisted in IndexedDB, and requests are signed with
          short-lived device JWTs. Read the <a href="/docs/security/">security model</a>
          or <a href="/install/">install Roost</a>.
        </p>
      </FeatureRow>
    </div>

    {/* 12 — How it works */}
    <div class="section">
      <p class="eyebrow">Architecture</p>
      <h2>How it works</h2>
      <pre class="diagram" aria-label="Architecture diagram: a browser talks to one coordinator over Connect-RPC, and the coordinator talks to one outbound-dialling worker per machine, each hosting its PTYs in a keeper subprocess">{DIAGRAM}</pre>
      <p class="lede after-diagram">
        The browser and the coordinator fold the same <code>foldEvent</code> reducer
        over the same append-only event log, so they agree on session state by
        construction rather than by carefully mirroring a snapshot.
      </p>
    </div>

    {/* 13 — Install */}
    <div class="section">
      <p class="eyebrow">Install</p>
      <h2>Two commands on the first macOS or Linux machine</h2>
      <div class="install">
        {/* The wrapper carries `min-width: 0`: a grid item defaults to a
            content-based minimum, and CtaBand's `white-space: pre` command block
            would otherwise widen the column past a 390px viewport instead of
            scrolling inside its own <pre>. */}
        <div class="cell">
          <CtaBand
            command={POSIX}
            note="macOS and Linux. The script verifies the release asset against its published .sha256 sidecar, then quickstart installs the coordinator, deploys a worker on the same machine, and opens your browser already authorized."
          />
        </div>
        <div class="cell">
          <CtaBand
            command={HOMEBREW}
            note="macOS only. For automatic mode, run sudo tailscaled install-system-daemon && sudo tailscale up, followed by roost quickstart. Direct HTTPS instead uses the three endpoint flags shown in the install guide."
          />
        </div>
      </div>
      <Callout tone="info" title="Automatic Tailscale Serve or direct HTTPS">
        <p>
          With no endpoint flags, <code>roost quickstart</code> configures Tailscale
          Serve in front of a loopback coordinator. Supply
          <code>--coordinator-url</code>, <code>--tls-cert</code>, and
          <code>--tls-key</code> together to serve a browser-trusted certificate
          directly; coordinator quickstart then does not use Tailscale. In v0.5.0,
          the extra-worker join script still requires a running Tailscale daemon in
          either mode. See <a href="/docs/networking/">networking</a>.
        </p>
      </Callout>
      <Callout tone="warn" title="Windows host releases are paused">
        <p>
          v0.5.0 publishes no Windows coordinator, worker, installer, join script, or
          package. Windows remains supported as a browser client, but there is no
          supported Windows host install, enrollment, or update procedure in this
          release.
        </p>
      </Callout>
    </div>

    {/* 14 — Where Roost fits */}
    <div class="section">
      <p class="eyebrow">Landscape</p>
      <h2>Where Roost fits</h2>
      <p class="lede fits">
        Most agent terminals are one polished app on one machine, and most cloud agent
        platforms run on someone else's VM.
      </p>
      <p class="lede fits">
        Roost sits between them: your own machines, real PTYs, and a browser client that
        happens to work on a phone.
      </p>
      <p class="lede fits">
        The comparisons are factual, name names, and each one ends with when to use the
        other tool instead.
      </p>
      <p class="fits-cta">
        <a class="btn" href="/alternatives/">Roost vs the agent terminal landscape</a>
      </p>
    </div>

    {/* 15 — FAQ */}
    <div class="section">
      <p class="eyebrow">FAQ</p>
      <h2>Questions people actually ask</h2>
      <dl class="faq">
        {
          FAQ.map((item) => (
            <div class="qa">
              <dt>{item.q}</dt>
              <dd>{item.a}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  {/* 16 — JSON-LD (data, not client script) */}
  <script type="application/ld+json" set:html={JSON.stringify(softwareApplication)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(faqPage)} is:inline />
</BaseLayout>

<style>
  .shot-hero {
    padding-block: var(--md-space-8) 0;
  }

  h2 {
    margin: 0 0 var(--md-space-4);
    font-size: var(--md-headline-l-size);
    line-height: var(--md-headline-l-line);
    font-weight: 600;
  }

  /* Long identifiers (roost add-machine --platform macos, owner/repo#123) must
     never be the reason a 360px viewport scrolls sideways. */
  code {
    overflow-wrap: anywhere;
  }

  .diagram {
    max-width: 100%;
    margin: 0;
    padding: var(--md-space-5);
    border: 1px solid var(--border-subtle);
    border-radius: var(--md-shape-md);
    background: var(--surface-0);
    color: var(--text-mid);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.5;
    white-space: pre;
    overflow-x: auto;
  }

  .after-diagram {
    margin: var(--md-space-6) 0 0;
    max-width: 72ch;
  }

  .after-diagram code {
    padding: 0.12em 0.36em;
    border: 1px solid var(--border-subtle);
    border-radius: var(--md-shape-xs);
    background: var(--surface-0);
    color: var(--text-hi);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .install {
    display: grid;
    gap: var(--md-space-4);
    margin-bottom: var(--md-space-6);
  }

  .cell {
    min-width: 0;
  }

  .fits {
    margin: 0 0 var(--md-space-3);
    max-width: 72ch;
  }

  .fits-cta {
    margin: var(--md-space-6) 0 0;
  }

  .faq {
    display: grid;
    gap: var(--md-space-5);
    margin: var(--md-space-6) 0 0;
    padding: 0;
  }

  .qa {
    padding-top: var(--md-space-5);
    border-top: 1px solid var(--border-subtle);
  }

  .qa:first-child {
    padding-top: 0;
    border-top: 0;
  }

  dt {
    margin-bottom: var(--md-space-2);
    color: var(--text-hi);
    font-size: var(--md-title-l-size);
    line-height: var(--md-title-l-line);
    font-weight: 600;
  }

  dd {
    margin: 0;
    max-width: 78ch;
    color: var(--text-mid);
    font-size: 16px;
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    h2 {
      font-size: 26px;
      line-height: 34px;
    }

    .diagram {
      font-size: 12px;
      padding: var(--md-space-4);
    }

    dt {
      font-size: 19px;
      line-height: 26px;
    }
  }
</style>
