---
import { getCollection, render, type CollectionEntry } from "astro:content";

import DocsLayout from "../../layouts/DocsLayout.astro";
import { clampDescription } from "../../lib/seo";

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

type Props = { entry: CollectionEntry<"docs"> };

const { entry } = Astro.props as Props;
const { Content } = await render(entry);

// `title` is the <title> tag, rendered verbatim by the layout, so it must
// already be final and <= 60 chars; the suffix is dropped rather than
// truncating a real doc title. `heading` is the on-page H1.
const SUFFIX = " \u2014 Roost docs";
const title =
  entry.data.title.length + SUFFIX.length <= 60 ? `${entry.data.title}${SUFFIX}` : entry.data.title;
---

<DocsLayout
  title={title}
  heading={entry.data.title}
  description={clampDescription(entry.data.description)}
  githubPath={`apps/site/src/content/docs/${entry.id}.md`}
>
  <Content />
</DocsLayout>
