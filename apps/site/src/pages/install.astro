---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import CtaBand from "../components/CtaBand.astro";
import Callout from "../components/Callout.astro";

/** Published macOS and Linux binaries are verified against their adjacent
 *  GitHub Release SHA-256 sidecars before installation. */
const INSTALL = `curl -fsSL https://raw.githubusercontent.com/cefege/roost/main/install-binary.sh | bash`;

const AUTOMATIC = `"$HOME/.local/bin/roost" quickstart`;

/** Direct mode requires one HTTPS origin and two absolute certificate paths. */
const DIRECT = `"$HOME/.local/bin/roost" quickstart \\
  --coordinator-url "https://roost.example.com:8443" \\
  --tls-cert "$HOME/.config/roost/tls/fullchain.pem" \\
  --tls-key "$HOME/.config/roost/tls/privkey.pem"`;

const HOMEBREW = `brew install cefege/tap/roost`;

const SOURCE = `curl -fsSL https://raw.githubusercontent.com/cefege/roost/main/install.sh | bash`;

const ASSETS: { name: string; host: string }[] = [
  { name: "roost", host: "macOS arm64 (compatibility name)" },
  { name: "roost-darwin-arm64", host: "macOS arm64" },
  { name: "roost-darwin-x64", host: "macOS x64" },
  { name: "roost-linux-x64", host: "Linux x64" },
  { name: "roost-linux-arm64", host: "Linux arm64" },
];
---

<BaseLayout
  title="Install Roost v0.5.0 — macOS and Linux"
  description="Install the released, accountless Roost v0.5.0 on macOS or Linux, then choose automatic Tailscale Serve or direct HTTPS for the coordinator."
>
  <Hero
    title="Self-host Roost v0.5.0"
    sub="Install the released open-source edition on macOS or Linux, with no Roost account or telemetry. Choose automatic Tailscale Serve or bring a browser-trusted certificate for direct HTTPS."
    badges={["v0.5.0", "macOS + Linux", "GPL-3.0-only"]}
  >
    <a class="btn btn-primary" href="/docs/install/">Full install guide</a>
    <a class="btn" href="/docs/quickstart/">Quickstart</a>
    <a class="btn" href="https://github.com/cefege/roost/releases">Release assets</a>
  </Hero>

  <div class="wrap">

    <section class="section">
      <p class="eyebrow">macOS and Linux</p>
      <h2>Install the verified v0.5.0 binary</h2>
      <p class="lede">
        The script resolves your OS and architecture to one published release
        asset, downloads it with its <code>.sha256</code> sidecar, refuses to
        install on a digest mismatch, and puts the binary in
        <code>$HOME/.local/bin</code>. Choose one of the two coordinator
        quickstart modes below after it finishes.
      </p>
      <CtaBand
        command={INSTALL}
        note="Supports macOS arm64/x64 and Linux arm64/x64. Override the install directory with ROOST_BIN_DIR."
      />
    </section>

    <section class="section">
      <p class="eyebrow">macOS</p>
      <h2>Homebrew</h2>
      <CtaBand
        command={HOMEBREW}
        note="macOS-only on purpose. After installation, choose either automatic Tailscale Serve or direct HTTPS below."
      />
    </section>

    <section class="section">
      <p class="eyebrow">Automatic HTTPS</p>
      <h2>Let Tailscale Serve the coordinator</h2>
      <p class="lede">
        With no endpoint flags, quickstart discovers the coordinator's tailnet
        hostname, keeps its plaintext listener on loopback, provisions HTTPS on
        port 4102, and configures Tailscale Serve. The coordinator, workers, and
        browsers using this route join the same tailnet.
      </p>
      <CtaBand
        command={AUTOMATIC}
        note="Install and connect Tailscale first. On Linux, also set the current user as the Tailscale operator."
      />
    </section>

    <section class="section">
      <p class="eyebrow">Direct HTTPS</p>
      <h2>Bring your own trusted hostname and certificate</h2>
      <p class="lede">
        Supply the coordinator URL, certificate, and key together. Direct
        coordinator quickstart does not resolve or call Tailscale; you own DNS,
        routing, firewall policy, and a certificate chain trusted by every
        browser and worker that connects to this origin.
      </p>
      <CtaBand
        command={DIRECT}
        note="The URL must include an explicit port. Certificate and key paths must be absolute, readable, distinct regular files."
      />
      <Callout tone="warn" title="Extra workers still require Tailscale in v0.5.0">
        <p>
          The current <code>join.sh</code> requires a running Tailscale daemon
          even when it enrolls against the direct HTTPS origin. Direct mode is
          Tailscale-free for the first coordinator and its local worker, but not
          yet for extra-worker enrollment.
        </p>
      </Callout>
    </section>

    <section class="section">
      <Callout tone="warn" title="Windows host releases are paused">
        <p>
          v0.5.0 publishes no Windows coordinator, worker, installer, join
          script, or package. A Windows PC remains supported as a browser
          client, but there is no Windows host install, enrollment, or update
          procedure in this release.
        </p>
      </Callout>
    </section>

    <section class="section">
      <p class="eyebrow">Release assets</p>
      <h2>One binary per host, each with a checksum</h2>
      <table class="assets">
        <thead>
          <tr><th scope="col">Asset</th><th scope="col">Host</th></tr>
        </thead>
        <tbody>
          {
            ASSETS.map((asset) => (
              <tr>
                <td><code>{asset.name}</code></td>
                <td>{asset.host}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="note">
        Every published asset ships a <code>.sha256</code> sidecar, and
        <code>roost</code> is byte-identical to
        <code>roost-darwin-arm64</code> so older release links keep working.
        See the <a href="https://github.com/cefege/roost/releases">releases</a>.
      </p>
    </section>

    <section class="section">
      <Callout tone="warn" title="The source script is not the release path">
        <p>
          <code>{SOURCE}</code> installs Bun and a checkout that tracks
          <code>main</code>, on macOS or Linux. It is for working on Roost, not
          for running it — use the verified binary installer above for anything
          you intend to keep running.
        </p>
      </Callout>
    </section>

    <section class="section">
      <h2>Next steps</h2>
      <div class="next">
        <a class="btn btn-primary" href="/docs/install/">Full install guide</a>
        <a class="btn" href="/docs/quickstart/">Pair a phone, add a machine</a>
        <a class="btn" href="/docs/networking/">Networking</a>
        <a class="btn" href="/docs/security/">Security model</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  h2 {
    margin: 0 0 var(--md-space-4);
    font-size: var(--md-headline-l-size);
    line-height: var(--md-headline-l-line);
    font-weight: var(--md-headline-l-weight);
    color: var(--text-hi);
  }

  .lede {
    max-width: 72ch;
  }

  .assets {
    width: 100%;
    max-width: 640px;
    border-collapse: collapse;
    font-size: var(--md-body-m-size);
    line-height: var(--md-body-m-line);
  }

  .assets th,
  .assets td {
    padding: var(--md-space-3) var(--md-space-4);
    border-bottom: 1px solid var(--border-subtle);
    text-align: left;
    color: var(--text-mid);
  }

  .assets th {
    color: var(--text-lo);
    font-size: var(--md-label-m-size);
    line-height: var(--md-label-m-line);
    font-weight: var(--md-label-m-weight);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .assets code {
    color: var(--text-hi);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .note {
    max-width: 72ch;
    margin-top: var(--md-space-5);
    color: var(--text-lo);
    font-size: var(--md-body-m-size);
    line-height: var(--md-body-m-line);
  }

  .next {
    display: flex;
    flex-wrap: wrap;
    gap: var(--md-space-3);
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.95em;
    color: var(--text-hi);
  }
</style>
