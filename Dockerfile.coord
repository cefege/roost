FROM oven/bun:1.3.14-debian@sha256:9dba1a1b43ce28c9d7931bfc4eb00feb63b0114720a0277a8f939ae4dfc9db6f AS build

ARG ROOST_VERSION
ARG ROOST_GIT_SHA

WORKDIR /src
COPY . .

RUN bun -e 'const version = Bun.env.ROOST_VERSION; const sha = Bun.env.ROOST_GIT_SHA; if (!version || !/^[0-9A-Za-z][0-9A-Za-z._+-]{0,127}$/.test(version)) throw new Error("ROOST_VERSION must be immutable release metadata"); if (!sha || !/^[0-9a-f]{40,64}$/i.test(sha)) throw new Error("ROOST_GIT_SHA must be a full immutable commit SHA")'
RUN bun install --frozen-lockfile

WORKDIR /src/apps/web
RUN ROOST_GIT_SHA="${ROOST_GIT_SHA}" bun x vite build

WORKDIR /src
RUN bun scripts/gen-embed.ts
RUN bun build --compile --target=bun-linux-x64 \
    --define "__ROOST_VERSION__=\"${ROOST_VERSION}\"" \
    --define "__ROOST_GIT_SHA__=\"${ROOST_GIT_SHA}\"" \
    apps/roost-cli/src/main.ts --outfile /roost

FROM gcr.io/distroless/base-debian12:nonroot@sha256:5883c320d81f76c764e114c9ab14054f037bb040907816fc9028d80d9602a7c3

COPY --from=build --chown=65532:65532 /roost /roost

ENV ROOST_MANAGED_CONTAINER=1 \
    ROOST_SAAS_MODE=1 \
    ROOST_TRUST_PROXY=1 \
    ROOST_COORDINATOR_BIND=127.0.0.1:4103 \
    ROOST_PUBLIC_BIND=0.0.0.0:4104 \
    ROOST_COORD_DATA_DIR=/data \
    ROOST_COORD_LOG_DIR=/data/logs

USER 65532:65532
EXPOSE 4104

HEALTHCHECK --interval=10s --timeout=6s --start-period=20s --retries=3 \
  CMD ["/roost", "__saas-instance", "health"]

ENTRYPOINT ["/roost"]
CMD ["coord"]
