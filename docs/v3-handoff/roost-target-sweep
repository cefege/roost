#!/bin/sh
# Deletes superseded test/bin executables in a cargo target dir: for every
# executable name under <target>/debug/deps, keeps only the newest hash and
# removes older ones (a changed dependency or feature set gives a test binary
# a new hash and cargo never removes the old one). Libraries are untouched.
# Usage: roost-target-sweep <target-dir>
set -eu
deps="$1/debug/deps"
[ -d "$deps" ] || exit 0
cd "$deps"
for name in $(ls | grep -vE '\.(d|rlib|rmeta|so|o)$' | grep -E -- '-[0-9a-f]{16}$' | sed -E 's/-[0-9a-f]{16}$//' | sort -u); do
  ls -t -- "$name"-* 2>/dev/null | grep -E -- "^$name-[0-9a-f]{16}\$" | tail -n +2 | while read -r stale; do
    rm -f -- "$stale" "$stale.d"
  done
done
