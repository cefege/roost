#!/bin/sh
# Host-wide build admission: at most two cargo builds run at once across all
# roost worktrees (disk budget agreed with the user). Usage:
#   flock <worktree>/target-track/.roost-build.lock /home/almalinux/repos/roost-build-slot cargo ...
# Blocks until one of two slots is free, then runs the command holding it and
# exits with the command's status.
dir=/home/almalinux/repos
while :; do
  for slot in 1 2; do
    flock -n -E 200 "$dir/.roost-build-slot-$slot" "$@"
    status=$?
    [ "$status" -ne 200 ] && exit "$status"
  done
  sleep 5
done
