{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    "apps/shared":   { "ignoreDependencies": ["@bufbuild/protoc-gen-es"], "entry": ["tests/**/*.test.ts"] },
    "apps/coord":    { "entry": ["tests/**/*.test.ts"] },
    "apps/worker":   { "entry": ["src/keeper/multiplexed-main.ts!", "tests/**/*.test.ts"], "ignoreBinaries": ["ip"] },
    "apps/web":      { "entry": ["index.html", "public/sw-push.js", "tests/**/*.test.ts"] },
    "apps/site":     { "entry": ["scripts/*.ts!", "src/pages/**/*.{astro,ts}"] },
    "smoke":         { "entry": ["*.test.ts", "terminal/live-stack.ts", "terminal/pty-fixture.ts", "terminal/resize-tui.ts"] }
  },
  "ignore": ["scripts/**"],
  "ignoreBinaries": ["vm_stat"]
}
