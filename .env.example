# Roost config template. Copy to `.env.local` (gitignored) and fill in the
# YOUR SETUP block. Bun auto-loads `.env.local` for CLI + vite dev; the
# install.sh scripts source it to bake the LaunchAgent env.
#
#   cp .env.example .env.local && $EDITOR .env.local
#
# Anything unset here falls back to a code default OR is derived at runtime
# (tailnet suffix ← `tailscale status`). Nothing is hardcoded to one person's
# machines — leave a value blank and Roost derives it or fails loud.

# ─────────────────────────────────────────────────────────────────────────
# YOUR SETUP — machine/tailnet specific. No personal default; derive or error.
# ─────────────────────────────────────────────────────────────────────────

# Tailnet DNS suffix used to build peer FQDNs (deploy reachable_addr, cert CN).
# Blank → derived from `tailscale status` Self.DNSName. Set it to skip the probe
# or when tailscale isn't reachable at deploy time. e.g. tailXXXXXX.ts.net
ROOST_TAILNET_SUFFIX=

# Fleet for `roost push` — comma-sep tailnet hostnames. No default; unset → push
# errors. e.g. my-mac-1,my-mac-2
ROOST_PUSH_TARGETS=

# Coord URL for `roost deploy` (baked into worker plists) + the vite dev /api
# proxy. e.g. https://your-coord-host:4102
ROOST_COORDINATOR_URL=

# Per-worker identity override for a fresh, single-target deploy. Blank address →
# `<host>.$ROOST_TAILNET_SUFFIX`. Fleet-push hosts must leave this and
# ROOST_WORKER_LABEL unset; enrolled targets reuse their installed identity.
ROOST_REACHABLE_ADDR=

# One-shot worker enrollment token (cleared after first redeem). e.g. roost_bt_...
ROOST_BOOTSTRAP_TOKEN=

# Loopback-only browser listener reached by Cloudflare Tunnel. Blank → disabled.
ROOST_PUBLIC_BIND=
# Public HTTPS origin served by the Tunnel; no path, query, or fragment.
ROOST_WEB_PUBLIC_URL=
# Cloudflare Access team domain, e.g. your-team.cloudflareaccess.com.
ROOST_CF_ACCESS_TEAM_DOMAIN=
# Cloudflare Access Application Audience (AUD) tag: exactly 64 lowercase hex.
ROOST_CF_ACCESS_AUD=

# ─────────────────────────────────────────────────────────────────────────
# DEFAULTS — sane out of the box; override only if you know why.
# Full list + defaults: apps/shared/src/config.ts (CoordConfig / WorkerConfig).
# ─────────────────────────────────────────────────────────────────────────

# ROOST_COORDINATOR_BIND=0.0.0.0:4102       # coord listen host:port
# ROOST_TLS_CERT_PATH=                       # set both cert+key → coord serves HTTPS
# ROOST_TLS_KEY_PATH=
# ROOST_CORS_ALLOWED_ORIGINS=                # comma-sep; empty = same-origin only
# ROOST_WORKER_LABEL=                        # default = hostname()
