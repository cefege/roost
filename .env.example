# Roost config template. Copy to `.env.local` (gitignored) and fill in the
# YOUR SETUP block. Bun auto-loads `.env.local` for CLI + vite dev; the
# install.sh scripts source it to bake the LaunchAgent env.
#
#   cp .env.example .env.local && $EDITOR .env.local
#
# Anything unset here falls back to a code default OR is derived at runtime
# (tailnet FQDNs ← `tailscale status`). Nothing is hardcoded to one person's
# machines — leave a value blank and Roost derives it or fails loud.

# ─────────────────────────────────────────────────────────────────────────
# YOUR SETUP — machine/tailnet specific. No personal default; derive or error.
# ─────────────────────────────────────────────────────────────────────────

# Fleet for `roost push` — comma-sep tailnet hostnames. No default; unset → push
# errors. e.g. my-mac-1,my-mac-2
ROOST_PUSH_TARGETS=

# Coord URL for `roost deploy` (baked into worker plists) + the vite dev /api
# proxy. e.g. https://your-coord-host:4102
ROOST_COORDINATOR_URL=

# Per-worker identity override for a fresh, single-target deploy. Blank address →
# the host's own `tailscale status` DNS name. Fleet-push hosts must leave this and
# ROOST_WORKER_LABEL unset; enrolled targets reuse their installed identity.
ROOST_REACHABLE_ADDR=

# One-shot worker enrollment token (cleared after first redeem). e.g. roost_bt_...
ROOST_BOOTSTRAP_TOKEN=

# Generic managed mode. A host-managed dedicated coordinator additionally sets
# ROOST_MANAGED_CONTAINER=1 and the strict per-instance values shown below.
ROOST_SAAS_MODE=1
ROOST_PUBLIC_BIND=127.0.0.1:4104
ROOST_WEB_PUBLIC_URL=https://dashboard.roosttt.com

# Dedicated coordinator container (operator-generated identity and route only):
# ROOST_MANAGED_CONTAINER=1
# ROOST_COORDINATOR_INSTANCE_ID=11111111-1111-4111-8111-111111111111
# ROOST_TENANT_ROUTE_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# ROOST_COORDINATOR_BIND=127.0.0.1:4103
# ROOST_PUBLIC_BIND=0.0.0.0:4104
# ROOST_WEB_PUBLIC_URL=https://dashboard.roosttt.com

# Self-hosted public mode only: set both values and ROOST_SAAS_MODE=0.
# ROOST_CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# ROOST_CF_ACCESS_AUD=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Email is one complete group. Dedicated containers require the two secret
# values via read-only files; generic profiles may use direct values instead.
# ROOST_RESEND_ENDPOINT=https://api.resend.com/emails
# ROOST_RESEND_API_KEY_FILE=/run/secrets/resend-api-key
# ROOST_EMAIL_FROM=Roost <noreply@example.com>
# ROOST_EMAIL_OUTBOX_KEY_FILE=/run/secrets/email-outbox-key
# ROOST_RESEND_API_KEY=
# ROOST_EMAIL_OUTBOX_KEY=

# Exact HTTPS Web Push provider origins. Empty disables Push and fails closed.
# ROOST_PUSH_ALLOWED_ORIGINS=https://fcm.googleapis.com,https://updates.push.services.mozilla.com

# ─────────────────────────────────────────────────────────────────────────
# DEFAULTS — sane out of the box; override only if you know why.
# Full list + defaults: apps/shared/src/config.ts (CoordConfig / WorkerConfig).
# ─────────────────────────────────────────────────────────────────────────

# ROOST_COORDINATOR_BIND=0.0.0.0:4102       # coord listen host:port
# ROOST_TLS_CERT_PATH=                       # set both cert+key → coord serves HTTPS
# ROOST_TLS_KEY_PATH=
# ROOST_CORS_ALLOWED_ORIGINS=                # comma-sep; empty = same-origin only
# ROOST_WORKER_LABEL=                        # default = hostname()
