.pytest_cache/

/.claude/worktrees/

# Generated by hand-run state tooling, never tracked: tracking it pollutes
# every `git status` and forces commits to include unrelated churn.
STATE.md

.claude/scheduled_tasks.lock

# Local-only: build cache + UI design mockups. Deploy CLI rejects
# any untracked entry (treats as dirty); ignoring keeps the tree
# deployable without committing scratch material.
.cache/
mockups/

/playwright-report/
/test-results/
# Scratch incident-evidence dumps (multi-GB Playwright traces).
/terminal-reader-fix-evidence/
# The parity runner's pinned oracle artifacts (smoke/parity/pin.ts); rebuilt by
# `bun smoke/parity/run.ts build`, never source.
/.smoke-pin/
