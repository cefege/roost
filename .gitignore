dist/
*.log
.DS_Store
.env
.env.*
coordinator_v2.db*
target/
# Per-agent isolated build dirs, so parallel agents never contend on the
# shared cargo lock. Build output, never source.
target-*/
__pycache__/
*.pyc
.venv/
.pytest_cache/

/.claude/worktrees/

# Generated by hand-run state tooling, never tracked: tracking it pollutes
# every `git status` and forces commits to include unrelated churn.
STATE.md

.claude/scheduled_tasks.lock

# Local-only: build cache + UI design mockups. Deploy CLI rejects
# any untracked entry (treats as dirty); ignoring keeps the tree
# deployable without committing scratch material.
.cache/
mockups/

