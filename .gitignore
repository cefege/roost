# Generated, never tracked — STATE.md by `roost state` (run by hand; the
# per-session Stop hook that wrote it was removed), keeper/main.js by
# `bun run build:keeper`. Tracking either of these
# pollutes every `git status` and forces phase commits to either include
# unrelated churn or run a pre-stage filter. Both are deterministically
# rebuilt from in-tree sources (roost-cli/src/state.ts + worker/src/keeper/main.ts).
STATE.md
apps/worker/src/keeper/main.js
apps/coord/src/web-embed.generated-assets/

.claude/scheduled_tasks.lock

# Local-only: build cache + UI design mockups. Deploy CLI rejects
# any untracked entry (treats as dirty); ignoring keeps the tree
# deployable without committing scratch material.
.cache/
mockups/

/playwright-report/
/test-results/

# Astro content-layer/type cache (apps/site).
apps/site/.astro/
