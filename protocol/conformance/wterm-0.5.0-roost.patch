+                &self.alt_saved_cursor_col,
+                cols,
+                rows,
+                self.scrollback,
+                false,
+            );
+            // The active alternate grid is top-anchored: shrinking discards
+            // bottom rows and clamps its cursor instead of scrolling a header
+            // out of view or adding alternate-screen rows to history.
+            resizeGrid(&self.grid, &self.cursor_row, &self.cursor_col, cols, rows, null, true);
+        } else {
+            resizeGrid(&self.grid, &self.cursor_row, &self.cursor_col, cols, rows, self.scrollback, false);
