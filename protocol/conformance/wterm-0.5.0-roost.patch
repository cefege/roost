+
+        if (cols == self.cols and rows == self.rows) return;
+
+        if (self.using_alt_screen) {
+            // alt_grid holds the saved primary screen while the alternate
+            // screen is active. Resize it as a primary grid, including history
+            // and the primary cursor captured on entry.
